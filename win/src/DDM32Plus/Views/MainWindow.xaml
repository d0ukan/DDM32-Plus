<Window x:Class="DDM32Plus.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:DDM32Plus.Localization"
        xmlns:p="clr-namespace:DDM32Plus.Views.Pages"
        Width="1100" Height="800" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Window}" FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True" Icon="/DDM32Plus;component/Assets/ddm32plus.ico"
        TextOptions.TextFormattingMode="Display">
    <!-- main_window.py: the toolbar (help, disclaimer, about; here also the language), the pages as tabs, the status bar -->
    <DockPanel>
        <Menu x:Name="MenuBar" DockPanel.Dock="Top" Background="{StaticResource Window}">
            <MenuItem Header="{l:Tr Menu_File}">
                <MenuItem Header="{l:Tr Tab_Home}" Tag="home" Click="OnMenuPage" />
                <MenuItem Header="{l:Tr Menu_OpenBackups}" Click="OnOpenBackups" />
                <MenuItem Header="{l:Tr Menu_OpenLogs}" Click="OnOpenLogs" />
                <Separator />
                <MenuItem Header="{l:Tr Menu_Exit}" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="{l:Tr Menu_Radio}">
                <MenuItem Header="{l:Tr Tab_Health}" Tag="health" Click="OnMenuPage" />
                <MenuItem Header="{l:Tr Tab_Live}" Tag="live" Click="OnMenuPage" />
                <MenuItem Header="{l:Tr Tab_SearchLog}" Tag="searchlog" Click="OnMenuPage" />
                <Separator />
                <MenuItem Header="{l:Tr Tab_Update}" Tag="update" Click="OnMenuPage" />
                <MenuItem Header="{l:Tr Tab_Restore}" Tag="restore" Click="OnMenuPage" />
            </MenuItem>
            <MenuItem Header="{l:Tr Menu_Tools}">
                <MenuItem Header="{l:Tr Tab_Channels}" Tag="channels" Click="OnMenuPage" />
                <MenuItem Header="{l:Tr Tab_Packs}" Tag="packs" Click="OnMenuPage" />
                <MenuItem Header="{l:Tr Tab_Versions}" Tag="versions" Click="OnMenuPage" />
                <MenuItem x:Name="MenuLocal" Header="{l:Tr Menu_LocalRelease}" Click="OnLocalRelease" Visibility="Collapsed" />
            </MenuItem>
            <MenuItem Header="{l:Tr Menu_HelpMenu}">
                <MenuItem Header="{l:Tr Menu_Guide}" Click="OnHelp" />
                <MenuItem Header="{l:Tr Menu_Disclaimer}" Click="OnDisclaimer" />
                <MenuItem Header="{l:Tr Menu_GitHub}" Click="OnGitHub" />
                <Separator />
                <MenuItem Header="{l:Tr Menu_About}" Click="OnAbout" />
            </MenuItem>
        </Menu>
        <ToolBarTray DockPanel.Dock="Top" Background="{StaticResource Window}" IsLocked="True">
            <ToolBar Background="{StaticResource Window}" Loaded="OnToolBarLoaded">
                <Button Click="OnHelp" ToolTip="{l:Tr Menu_HelpTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE897;" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr Menu_Help}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="OnDisclaimer" ToolTip="{l:Tr Menu_DisclaimerTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource Amber}" />
                        <TextBlock Text="{l:Tr Menu_Disclaimer}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Click="OnAbout" ToolTip="{l:Tr Menu_AboutTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE946;" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource Info}" />
                        <TextBlock Text="{l:Tr Menu_About}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="LocalButton" Click="OnLocalRelease" ToolTip="{l:Tr Menu_LocalReleaseTip}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr Menu_LocalRelease}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Separator />
                <Menu Background="Transparent" VerticalAlignment="Center" ToolTip="{l:Tr Menu_LanguageTip}">
                    <MenuItem x:Name="LanguageMenu">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE774;" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{l:Tr Menu_Language}" VerticalAlignment="Center" />
                            </StackPanel>
                        </MenuItem.Header>
                        <MenuItem x:Name="MenuTr" Header="{l:Tr Lang_Tr}" IsCheckable="True" Click="OnTurkish" />
                        <MenuItem x:Name="MenuEn" Header="{l:Tr Lang_En}" IsCheckable="True" Click="OnEnglish" />
                    </MenuItem>
                </Menu>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource Window}" BorderBrush="{StaticResource Frame}" BorderThickness="0,1,0,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock x:Name="StatusCable" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="StatusData" ToolTip="{l:Tr Status_DataTip}" MaxWidth="560" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right" Margin="0,0,16,0">
                <TextBlock x:Name="StatusInstalled" />
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="Tabs" Margin="6,6,6,4">
            <TabItem x:Name="TabHome">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE80F;" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr Tab_Home}" />
                    </StackPanel>
                </TabItem.Header>
                <p:HomePage x:Name="Home" />
            </TabItem>
            <TabItem x:Name="TabUpdate">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74A;" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr Tab_Update}" />
                    </StackPanel>
                </TabItem.Header>
                <p:UpdatePage x:Name="Update" />
            </TabItem>
            <TabItem x:Name="TabVersions">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8FD;" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr Tab_Versions}" />
                    </StackPanel>
                </TabItem.Header>
                <p:VersionsPage x:Name="Versions" />
            </TabItem>
            <TabItem x:Name="TabRestore">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72B;" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr Tab_Restore}" />
                    </StackPanel>
                </TabItem.Header>
                <p:RestorePage x:Name="Restore" />
            </TabItem>
            <TabItem x:Name="TabPacks">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8F1;" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr Tab_Packs}" />
                    </StackPanel>
                </TabItem.Header>
                <p:DataPacksPage x:Name="Packs" />
            </TabItem>
            <TabItem x:Name="TabHealth">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE946;" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr Tab_Health}" />
                    </StackPanel>
                </TabItem.Header>
                <p:HealthPage x:Name="Health" />
            </TabItem>
            <TabItem x:Name="TabLive">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr Tab_Live}" />
                    </StackPanel>
                </TabItem.Header>
                <p:LivePage x:Name="Live" />
            </TabItem>
            <TabItem x:Name="TabSearchLog">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr Tab_SearchLog}" />
                    </StackPanel>
                </TabItem.Header>
                <p:SearchLogPage x:Name="SearchLog" />
            </TabItem>
            <TabItem x:Name="TabChannels">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A4;" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr Tab_Channels}" />
                    </StackPanel>
                </TabItem.Header>
                <p:ChannelsPage x:Name="Channels" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
