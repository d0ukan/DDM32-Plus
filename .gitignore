!/win/src/DDM32Plus.Core/Radio/Data/ram-monitor.bin
!/win/src/DDM32Plus.Core/Radio/Data/codec-dm32.json
!/win/installer/*.iss
!/win/docs/*.md
!/win/docs/screenshots/*.png
/win/**/bin/
/win/**/obj/
/win/publish/
/win/publish-dev/
/win/publish-dev-write/
/win/publish-dev-write-next/
