!/win/src/**/*.cs
!/win/src/**/*.xaml
!/win/src/**/*.resx
!/win/src/**/*.pubxml
!/win/src/**/app.manifest
!/win/src/**/*.ico
!/win/tools/*.py
!/win/tests/**/*.csproj
!/win/tests/**/*.cs
!/win/tests/DDM32Plus.Core.Tests/Fixtures/*.py
!/win/tests/DDM32Plus.Core.Tests/Fixtures/*.json
!/win/tests/DDM32Plus.Core.Tests/Fixtures/*.json.gz
