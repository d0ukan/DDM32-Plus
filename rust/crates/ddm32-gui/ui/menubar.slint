// The classic menu bar across the top of the window: File, Radio, Tools, Help. It only reaches what the window
// already has (pages, folders, links); it never starts a radio step. Every colour from Theme, every text from Tr.
import { Theme } from "theme.slint";
import { Tr, Modal } from "widgets.slint";

export struct MenuEntry { text: string, action: string, enabled: bool, separator: bool }

// one menu: its name on the bar, its entries in a drop-down below it
component MenuHead inherits Rectangle {
    in property <string> text;
    in property <[MenuEntry]> entries;
    callback chosen(string);
    min-height: 32px;
    preferred-width: lbl.preferred-width + 24px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: !Modal.open;
    accessible-action-default => { if !Modal.open { pop.show(); } }
    background: ta.has-hover ? Theme.button-hover : transparent;
    lbl := Text {
        text: root.text;
        color: Theme.text;
        font-size: Theme.font;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    ta := TouchArea {
        enabled: !Modal.open;
        clicked => { pop.show(); }
    }
    pop := PopupWindow {
        x: 0px;
        y: root.height;
        width: 260px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 3px;
                spacing: 0px;
                for e in root.entries : Rectangle {
                    min-height: e.separator ? 9px : 32px;
                    if e.separator : Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }
                    if !e.separator : Rectangle {
                        background: row.has-hover && e.enabled ? Theme.button-hover : transparent;
                        accessible-role: button;
                        accessible-label: e.text;
                        accessible-enabled: e.enabled;
                        accessible-action-default => { if e.enabled { pop.close(); root.chosen(e.action); } }
                        Text {
                            x: 10px;
                            width: parent.width - 20px;
                            text: e.text;
                            color: e.enabled ? Theme.text : Theme.disabled-text;
                            font-size: Theme.font;
                            vertical-alignment: center;
                        }
                        row := TouchArea {
                            enabled: e.enabled;
                            clicked => { pop.close(); root.chosen(e.action); }
                        }
                    }
                }
            }
        }
    }
}

// the cable control at the bar's right end: "Cable: COM14 (auto)" and its Change button (opens the picker)
component CableHead inherits HorizontalLayout {
    in property <string> text;
    in property <bool> enabled;
    callback clicked;
    spacing: 8px;
    padding-right: 4px;
    alignment: end;
    Text {
        text: root.text;
        color: Theme.text-muted;
        font-size: Theme.font-small;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
        min-width: 60px;
    }
    Rectangle {
        min-height: 32px;
        min-width: max(64px, cl.preferred-width + 20px);
        horizontal-stretch: 0;
        border-radius: Theme.radius;
        border-width: cfs.has-focus ? 2px : 1px;
        border-color: cfs.has-focus ? Theme.focus : Theme.border;
        background: !root.enabled ? Theme.disabled : cta.has-hover ? Theme.button-hover : Theme.button;
        accessible-role: button;
        accessible-label: Tr.t(Tr.lang, "b_change") + " — " + root.text;
        accessible-enabled: root.enabled;
        accessible-action-default => { if root.enabled { root.clicked(); } }
        cfs := FocusScope {
            enabled: root.enabled;
            key-pressed(event) => {
                if (event.text == " " || event.text == "\n") && root.enabled { root.clicked(); return accept; }
                reject
            }
        }
        cl := Text {
            text: Tr.t(Tr.lang, "b_change");
            color: root.enabled ? Theme.button-text : Theme.disabled-text;
            font-size: Theme.font-small;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        cta := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => { root.clicked(); }
        }
    }
}

export component MenuBar inherits Rectangle {
    // locked: a radio step, the live panel or the search log holds the port (or an install / backup / update runs):
    // no page is left and the window is not closed until it has stopped
    in property <bool> radio-locked;
    // the cable picker's header text; Change opens the picker (not while the port is held)
    in property <string> cable-text;
    // the port is held, or the update wizard is between its radio steps: the port is not changed now
    in property <bool> cable-locked;
    callback cable-clicked;
    callback action(string);
    background: Theme.surface;
    min-height: 33px;
    max-height: 33px;
    vertical-stretch: 0;
    HorizontalLayout {
        padding-left: 4px;
        padding-bottom: 1px;
        alignment: stretch;
        MenuHead {
            text: Tr.t(Tr.lang, "m_file");
            entries: [
                { text: Tr.t(Tr.lang, "back_home"), action: "page:0", enabled: !root.radio-locked },
                { text: Tr.t(Tr.lang, "m_open_backups"), action: "backups-folder", enabled: true },
                { text: Tr.t(Tr.lang, "m_open_logs"), action: "logs-folder", enabled: true },
                { text: Tr.t(Tr.lang, "home_settings"), action: "page:4", enabled: !root.radio-locked },
                { separator: true },
                { text: Tr.t(Tr.lang, "m_exit"), action: "exit", enabled: !root.radio-locked },
            ];
            chosen(a) => { root.action(a); }
        }
        MenuHead {
            text: Tr.t(Tr.lang, "m_radio");
            entries: [
                { text: Tr.t(Tr.lang, "home_health"), action: "page:7", enabled: !root.radio-locked },
                { text: Tr.t(Tr.lang, "home_live"), action: "page:8", enabled: !root.radio-locked },
                { text: Tr.t(Tr.lang, "home_slog"), action: "page:10", enabled: !root.radio-locked },
                { separator: true },
                { text: Tr.t(Tr.lang, "home_update"), action: "page:1", enabled: !root.radio-locked },
                { text: Tr.t(Tr.lang, "home_backups"), action: "page:2", enabled: !root.radio-locked },
            ];
            chosen(a) => { root.action(a); }
        }
        MenuHead {
            text: Tr.t(Tr.lang, "m_tools");
            entries: [
                { text: Tr.t(Tr.lang, "home_channels"), action: "page:9", enabled: !root.radio-locked },
                { text: Tr.t(Tr.lang, "home_packs"), action: "page:3", enabled: !root.radio-locked },
            ];
            chosen(a) => { root.action(a); }
        }
        MenuHead {
            text: Tr.t(Tr.lang, "m_help");
            entries: [
                { text: Tr.t(Tr.lang, "m_guide"), action: "guide", enabled: true },
                { text: Tr.t(Tr.lang, "m_github"), action: "github", enabled: true },
                { text: Tr.t(Tr.lang, "m_disclaimer"), action: "disclaimer", enabled: true },
                { separator: true },
                { text: Tr.t(Tr.lang, "home_about"), action: "page:5", enabled: !root.radio-locked },
            ];
            chosen(a) => { root.action(a); }
        }
        if root.cable-text != "" : CableHead {
            horizontal-stretch: 1;
            text: root.cable-text;
            enabled: !root.cable-locked && !Modal.open;
            clicked => { root.cable-clicked(); }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}
