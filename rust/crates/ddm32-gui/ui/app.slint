// SPDX-License-Identifier: GPL-3.0-or-later
// DDM32 Plus: one window. A home screen with one main action, a wizard that asks one thing per screen, and four plain
// pages (backups, data packs, settings, about). Every colour from Theme, every text from Tr (tr / en).
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Tr, Label, Muted, Title, Heading, Button, Card, Notice, Check, Choice, Progress, PageHeader } from "widgets.slint";
import { MenuBar } from "menubar.slint";
import { Radio, Fact, TableRow, HealthPage, LivePage, ChannelsPage, SearchLogPage } from "radio_pages.slint";
export { Theme, Tr, Radio, Fact, TableRow }

export struct VersionRow { version: string, label: string, notes: string, local: bool }
export struct BackupRow { name: string, detail: string, origin: string, kind: string }

export global App {
    // 0 home, 1 update wizard, 2 backups and going back, 3 data packs, 4 settings, 5 about, 6 first start, 7 health, 8 live, 9 my channels
    in-out property <int> page: 0;
    // the home screen
    in property <string> radio-text;
    in property <string> radio-kind: "info";
    in property <string> update-text;
    in property <string> backups-text;
    in property <string> installed-text;
    // the wizard: 0 version, 1 backup choice, 2 backup, 3 check, 4 install, 5 done
    in-out property <int> step: 0;
    in property <[VersionRow]> versions;
    in-out property <int> selected-version: 0;
    in-out property <int> backup-choice: 0;   // 0 new backup, 1 last backup (quick), 2 no backup
    in property <bool> quick-available;
    in property <string> quick-backup;
    in-out property <bool> understood;
    in-out property <bool> confirm-open;
    in property <bool> busy;
    in property <bool> step-done;            // the current step succeeded: Next is open
    in property <string> message;
    in property <string> message-kind: "info";
    in property <string> power-prompt;
    in property <float> progress;
    in property <string> progress-text;      // the percent line (phase and percent); never a raw tool line
    in property <string> progress-info;      // the last other tool line (JEDEC ID, boot ROM answered, ...)
    in property <string> summary;
    in property <string> details;
    in-out property <bool> show-details;
    in property <bool> radio-access;
    // backups page
    in property <[BackupRow]> backups;
    in-out property <int> selected-backup: -1;
    in property <string> backups-folder;
    in property <bool> restore-ready;
    // data packs
    in property <string> pack-text;
    in property <bool> pack-ready;
    // settings
    in-out property <int> channel: 0;   // 0 Latest, 1 Beta, 2 Test / Alpha
    in-out property <bool> auto-check: true;
    // about
    in property <string> version;
    in property <string> data-folder;
    in property <string> key-id;

    callback navigate(int);
    callback refresh();
    callback wizard-next();
    callback wizard-back();
    callback start-backup();
    callback start-install();
    callback choose-backup(int);
    callback confirm-no-backup();
    callback restore();
    callback restore-plan();
    callback pack-radioid();
    callback pack-air();
    callback pack-write();
    callback set-theme(bool);
    callback set-lang(string);
    callback set-channel(int);
    callback set-auto-check(bool);
    callback open-backups-folder();
    // an entry of the menu bar: "page:N", "backups-folder", "logs-folder", "guide", "github" or "exit"
    callback menu-action(string);
    // the menu bar: the radio entries are off while any radio step, the live panel or the search log holds the port
    out property <bool> menu-radio-locked: root.busy || Radio.busy || Radio.live-running || Radio.slog-running;
    // the program's own update
    in property <string> app-update-text;
    in property <bool> app-update-available;
    callback app-check();
    callback app-update();
}

// a page: the header row across the window, then the page's own content
component Page inherits VerticalLayout {
    in property <string> heading;
    in property <bool> back: true;
    padding: 0;
    spacing: 0;
    PageHeader {
        heading: root.heading;
        back: root.back;
        back-text: Tr.t(Tr.lang, "back_home");
        back-enabled: !App.busy;
        back-clicked => { App.navigate(0); }
    }
    VerticalLayout {
        padding: Theme.pad;
        spacing: Theme.gap;
        @children
    }
}

component Home inherits VerticalLayout {
    padding: 0;
    spacing: 0;
    // the header row: the program's name, its version and the owner's mark (in the theme's own variant)
    PageHeader {
        heading: "DDM32 Plus";
        back: false;
        logo: Theme.dark ? @image-url("logo-dark.png") : @image-url("logo-light.png");
        Muted { text: App.version; vertical-alignment: center; horizontal-stretch: 0; }
    }
    VerticalLayout {
        padding: Theme.pad;
        spacing: Theme.gap;
        vertical-stretch: 1;
        // the cable and the version on offer
        Notice { text: App.radio-text; kind: App.radio-kind; }
        if App.update-text != "" : Muted { text: App.update-text; font-size: Theme.font; }
        // the main action
        HorizontalLayout {
            padding-top: 6px;
            padding-bottom: 6px;
            alignment: start;
            Button {
                text: Tr.t(Tr.lang, "home_update");
                kind: "primary";
                big: true;
                default-focus: true;
                min-width: 240px;
                clicked => { App.navigate(1); }
            }
        }
        HorizontalLayout {
            spacing: Theme.gap;
            Button { even: true; text: Tr.t(Tr.lang, "home_backups"); clicked => { App.navigate(2); } }
            Button { even: true; text: Tr.t(Tr.lang, "home_packs"); clicked => { App.navigate(3); } }
            Button { even: true; text: Tr.t(Tr.lang, "home_channels"); clicked => { App.navigate(9); } }
        }
        HorizontalLayout {
            spacing: Theme.gap;
            Button { even: true; text: Tr.t(Tr.lang, "home_health"); clicked => { App.navigate(7); } }
            Button { even: true; text: Tr.t(Tr.lang, "home_live"); clicked => { App.navigate(8); } }
            Button { even: true; text: Tr.t(Tr.lang, "home_slog"); clicked => { App.navigate(10); } }
            Button { even: true; text: Tr.t(Tr.lang, "home_settings"); clicked => { App.navigate(4); } }
        }
        Rectangle { vertical-stretch: 1; }
    }
    // calm facts, in a bar at the bottom: what the radio runs (by the last backup) and where the backups are
    Rectangle {
        background: Theme.surface;
        vertical-stretch: 0;
        min-height: facts.preferred-height;
        Rectangle { y: 0; height: 1px; background: Theme.border; }
        facts := HorizontalLayout {
            padding-left: Theme.pad;
            padding-right: Theme.pad;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: Theme.gap;
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Label { text: App.installed-text; font-size: Theme.font-small; }
                Muted { text: App.backups-text + "  " + App.backups-folder; }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                Button { text: Tr.t(Tr.lang, "b_open"); clicked => { App.open-backups-folder(); } }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                Button { text: Tr.t(Tr.lang, "home_about"); clicked => { App.navigate(5); } }
            }
        }
    }
}

// the wizard's steps in one row: done in green, the current one in the accent with a line under it, the rest muted
component StepBar inherits HorizontalLayout {
    spacing: 4px;
    for name[i] in [Tr.t(Tr.lang, "s_version"), Tr.t(Tr.lang, "s_backup"), Tr.t(Tr.lang, "s_check"), Tr.t(Tr.lang, "s_install"), Tr.t(Tr.lang, "s_done")] : Rectangle {
        property <int> n: i == 0 ? 0 : i == 1 ? 1 : i == 2 ? 3 : i == 3 ? 4 : 5;
        property <bool> active: App.step == n || (i == 1 && App.step == 2);
        property <bool> done: App.step > n && !active;
        // five equal parts, whatever the words
        preferred-width: 100px;
        horizontal-stretch: 1;
        min-height: st.preferred-height + 12px;
        st := Text {
            text: (i + 1) + ". " + name;
            color: active ? Theme.accent-text : done ? Theme.success : Theme.text-muted;
            font-size: Theme.font-small;
            font-weight: active ? 600 : 400;
            horizontal-alignment: center;
            wrap: word-wrap;
            width: parent.width - 8px;
        }
        Rectangle {
            y: parent.height - 2px;
            height: 2px;
            background: active ? Theme.primary : done ? Theme.success : Theme.border;
        }
    }
}

component Wizard inherits Page {
    heading: Tr.t(Tr.lang, "home_update");
    StepBar {}
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: Theme.gap;
            padding-right: 8px;
            alignment: start;
            // 0: which version
            if App.step == 0 : VerticalLayout {
                spacing: Theme.gap;
                alignment: start;
                Heading { text: Tr.t(Tr.lang, "q_version"); font-size: Theme.font-big; }
                for v[i] in App.versions : Choice {
                    title: v.version + "   " + v.label;
                    detail: v.notes;
                    selected: App.selected-version == i;
                    clicked => { App.selected-version = i; }
                }
                if App.versions.length == 0 : Notice { text: Tr.t(Tr.lang, "no_versions"); kind: "warning"; }
            }
            // 1: how to keep the radio safe
            if App.step == 1 : VerticalLayout {
                spacing: Theme.gap;
                alignment: start;
                Heading { text: Tr.t(Tr.lang, "q_backup"); font-size: Theme.font-big; }
                Choice {
                    title: Tr.t(Tr.lang, "c_new"); detail: Tr.t(Tr.lang, "c_new_d");
                    selected: App.backup-choice == 0;
                    clicked => { App.choose-backup(0); }
                }
                Choice {
                    title: Tr.t(Tr.lang, "c_quick");
                    detail: App.quick-available ? Tr.t(Tr.lang, "c_quick_d") + " " + App.quick-backup : Tr.t(Tr.lang, "c_quick_none");
                    enabled: App.quick-available;
                    selected: App.backup-choice == 1;
                    clicked => { App.choose-backup(1); }
                }
                Choice {
                    title: Tr.t(Tr.lang, "c_none"); detail: Tr.t(Tr.lang, "c_none_d");
                    danger: true;
                    selected: App.backup-choice == 2;
                    clicked => { App.choose-backup(2); }
                }
                if App.backup-choice == 2 : VerticalLayout {
                    spacing: Theme.gap;
                    Notice { text: Tr.t(Tr.lang, "none_warning"); kind: "danger"; }
                    Check { text: Tr.t(Tr.lang, "none_understood"); checked <=> App.understood; }
                }
            }
            // 2: the backup (a radio step: one button, the radio switched off and on)
            if App.step == 2 : VerticalLayout {
                spacing: Theme.gap;
                alignment: start;
                Notice { text: App.power-prompt; kind: "warning"; big: true; }
                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: Tr.t(Tr.lang, "b_start_backup"); kind: "primary"; big: true;
                        enabled: !App.busy && !App.step-done && App.radio-access && !Radio.slog-running;
                        clicked => { App.start-backup(); }
                    }
                }
            }
            // 3: the check, in plain words; the numbers under Details
            if App.step == 3 : VerticalLayout {
                spacing: Theme.gap;
                alignment: start;
                Label { text: App.summary; }
            }
            // 4: the install (a radio step)
            if App.step == 4 : VerticalLayout {
                spacing: Theme.gap;
                alignment: start;
                Notice { text: App.power-prompt; kind: "warning"; big: true; }
                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: Tr.t(Tr.lang, "b_start_install"); kind: App.backup-choice == 2 ? "danger" : "primary"; big: true;
                        enabled: !App.busy && !App.step-done && App.radio-access && !Radio.slog-running;
                        clicked => { App.start-install(); }
                    }
                }
            }
            // 5: done
            if App.step == 5 : VerticalLayout {
                spacing: Theme.gap;
                alignment: start;
                Notice { text: Tr.t(Tr.lang, "done_text"); kind: "success"; big: true; }
            }
            if App.busy || App.progress > 0 : VerticalLayout {
                spacing: 6px;
                Progress { value: App.progress; }
                Muted { text: App.progress-text; }
                if App.progress-info != "" : Muted { text: App.progress-info; font-size: Theme.font-small; }
            }
            if App.message != "" : Notice { text: App.message; kind: App.message-kind; }
            if !App.radio-access && (App.step == 2 || App.step == 4) : Notice { text: Tr.t(Tr.lang, "no_radio_access"); kind: "warning"; }
            if App.details != "" : VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: (App.show-details ? "− " : "+ ") + Tr.t(Tr.lang, "details");
                        clicked => { App.show-details = !App.show-details; }
                    }
                }
                if App.show-details : Card {
                    min-height: dt.preferred-height + 24px;
                    dt := Text {
                        x: 12px; width: parent.width - 24px;
                        text: App.details; color: Theme.text-muted; font-size: Theme.font-small; font-family: "Consolas";
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
    HorizontalLayout {
        spacing: Theme.gap;
        alignment: end;
        vertical-stretch: 0;
        if App.step > 0 && App.step < 5 : Button {
            text: Tr.t(Tr.lang, "b_back"); enabled: !App.busy;
            clicked => { App.wizard-back(); }
        }
        if App.step < 5 : Button {
            text: Tr.t(Tr.lang, "b_next"); kind: "primary"; default-focus: true;
            enabled: !App.busy && (App.step == 0 ? App.versions.length > 0
                : App.step == 1 ? (App.backup-choice != 2 || App.understood)
                : App.step-done);
            clicked => { App.wizard-next(); }
        }
        if App.step == 5 : Button { text: Tr.t(Tr.lang, "b_finish"); kind: "primary"; default-focus: true; clicked => { App.navigate(0); } }
    }
}

component Backups inherits Page {
    heading: Tr.t(Tr.lang, "home_backups");
    Muted { text: Tr.t(Tr.lang, "backups_where") + " " + App.backups-folder; }
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 8px;
            padding-right: 8px;
            alignment: start;
            for b[i] in App.backups : Choice {
                title: b.name; detail: b.detail;
                selected: App.selected-backup == i;
                clicked => { App.selected-backup = i; App.restore-plan(); }
            }
            if App.backups.length == 0 : Notice { text: Tr.t(Tr.lang, "backups_none"); }
        }
    }
    if App.message != "" : Notice { text: App.message; kind: App.message-kind; }
    if App.busy || App.progress > 0 : VerticalLayout {
        spacing: 6px;
        Progress { value: App.progress; }
        if App.progress-text != "" : Muted { text: App.progress-text; }
        if App.progress-info != "" : Muted { text: App.progress-info; font-size: Theme.font-small; }
    }
    HorizontalLayout {
        spacing: Theme.gap;
        alignment: end;
        Button { text: Tr.t(Tr.lang, "b_open_folder"); clicked => { App.open-backups-folder(); } }
        Button {
            text: Tr.t(Tr.lang, "b_restore"); kind: "primary";
            enabled: App.restore-ready && !App.busy && App.radio-access && !Radio.slog-running;
            clicked => { App.restore(); }
        }
    }
}

component Packs inherits Page {
    heading: Tr.t(Tr.lang, "home_packs");
    Label { text: Tr.t(Tr.lang, "packs_intro"); }
    HorizontalLayout {
        spacing: Theme.gap;
        alignment: start;
        Button { text: Tr.t(Tr.lang, "b_pack_radioid"); enabled: !App.busy; clicked => { App.pack-radioid(); } }
        Button { text: Tr.t(Tr.lang, "b_pack_air"); enabled: !App.busy; clicked => { App.pack-air(); } }
    }
    if App.pack-text != "" : Notice { text: App.pack-text; kind: App.pack-ready ? "success" : "info"; }
    if App.message != "" : Notice { text: App.message; kind: App.message-kind; }
    HorizontalLayout {
        alignment: start;
        Button {
            text: Tr.t(Tr.lang, "b_pack_write"); kind: "primary";
            enabled: App.pack-ready && !App.busy && App.radio-access && !Radio.slog-running;
            clicked => { App.pack-write(); }
        }
    }
    Muted { text: Tr.t(Tr.lang, "packs_note"); }
    Rectangle {}
}

// the program's own update (through the signed manifest)
component ProgramUpdate inherits Card {
    min-height: pu.preferred-height;
    vertical-stretch: 0;
    pu := VerticalLayout {
        padding: Theme.pad;
        spacing: 10px;
        Heading { text: Tr.t(Tr.lang, "pu_title"); }
        Label { text: App.app-update-text; }
        HorizontalLayout {
            spacing: Theme.gap;
            alignment: start;
            Button { text: Tr.t(Tr.lang, "pu_check"); enabled: !App.busy; clicked => { App.app-check(); } }
            Button {
                text: Tr.t(Tr.lang, "pu_install"); kind: "primary";
                enabled: App.app-update-available && !App.busy;
                clicked => { App.app-update(); }
            }
        }
    }
}

component Settings inherits Page {
    heading: Tr.t(Tr.lang, "home_settings");
    // scrolls when the window is small (150 % / 200 % scaling on a small screen)
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: Theme.gap;
            padding-right: 8px;
            alignment: start;
            Heading { text: Tr.t(Tr.lang, "set_lang"); }
            HorizontalLayout {
                spacing: Theme.gap;
                Choice { title: "Türkçe"; detail: ""; selected: Tr.lang == "tr"; clicked => { App.set-lang("tr"); } }
                Choice { title: "English"; detail: ""; selected: Tr.lang == "en"; clicked => { App.set-lang("en"); } }
            }
            Heading { text: Tr.t(Tr.lang, "set_theme"); }
            HorizontalLayout {
                spacing: Theme.gap;
                Choice { title: Tr.t(Tr.lang, "theme_light"); detail: ""; selected: !Theme.dark; clicked => { App.set-theme(false); } }
                Choice { title: Tr.t(Tr.lang, "theme_dark"); detail: ""; selected: Theme.dark; clicked => { App.set-theme(true); } }
            }
            Heading { text: Tr.t(Tr.lang, "set_channel"); }
            HorizontalLayout {
                spacing: Theme.gap;
                Choice { title: Tr.t(Tr.lang, "ch_latest"); detail: Tr.t(Tr.lang, "ch_latest_d"); selected: App.channel == 0; clicked => { App.set-channel(0); } }
                Choice { title: Tr.t(Tr.lang, "ch_beta"); detail: Tr.t(Tr.lang, "ch_beta_d"); selected: App.channel == 1; clicked => { App.set-channel(1); } }
                Choice { title: Tr.t(Tr.lang, "ch_test"); detail: Tr.t(Tr.lang, "ch_test_d"); selected: App.channel == 2; danger: true; clicked => { App.set-channel(2); } }
            }
            Check {
                text: Tr.t(Tr.lang, "set_auto");
                checked <=> App.auto-check;
                toggled => { App.set-auto-check(App.auto-check); }
            }
            ProgramUpdate {}
        }
    }
}

component About inherits Page {
    heading: Tr.t(Tr.lang, "home_about");
    // scrolls when the window is small (150 % / 200 % scaling on a small screen)
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: Theme.gap;
            padding-right: 8px;
            alignment: start;
            Card {
                min-height: av.preferred-height;
                av := VerticalLayout {
                    padding: Theme.pad; spacing: 8px;
                    Heading { text: "DDM32 Plus " + App.version; font-size: Theme.font-big; }
                    Label { text: Tr.t(Tr.lang, "about_text"); }
                    Muted { text: Tr.t(Tr.lang, "about_data") + " " + App.data-folder; }
                    Muted { text: Tr.t(Tr.lang, "about_key") + " " + App.key-id; }
                    Muted { text: "d0ukan · TA2DOU — github.com/d0ukan/DDM32-Plus"; }
                    Muted { text: Tr.t(Tr.lang, "about_licence"); }
                    Muted { text: "Made with Slint (slint.dev)"; }
                }
            }
            ProgramUpdate {}
        }
    }
}

// the first start: the language, before anything else
component FirstStart inherits VerticalLayout {
    padding: Theme.pad * 2;
    spacing: Theme.gap * 1.5;
    alignment: center;
    Title { text: "DDM32 Plus"; horizontal-alignment: center; }
    Label { text: "Dil seçin / Choose a language"; horizontal-alignment: center; }
    HorizontalLayout {
        spacing: Theme.gap;
        alignment: center;
        Button { text: "Türkçe"; kind: "primary"; big: true; default-focus: true; min-width: 160px; clicked => { App.set-lang("tr"); App.navigate(0); } }
        Button { text: "English"; kind: "primary"; big: true; min-width: 160px; clicked => { App.set-lang("en"); App.navigate(0); } }
    }
}

export component AppWindow inherits Window {
    title: "DDM32 Plus - TA2DOU";
    // the title bar and taskbar icon (the program's logo, as the setup's shortcuts)
    icon: @image-url("../../../packaging/art/ddm32plus.png");
    preferred-width: 900px;
    preferred-height: 720px;
    min-width: 640px;
    min-height: 560px;
    background: Theme.window;
    default-font-size: Theme.font;

    VerticalLayout {
        padding: 0;
        spacing: 0;
        if App.page != 6 : MenuBar {
            radio-locked: App.menu-radio-locked || App.confirm-open;
            action(a) => { App.menu-action(a); }
        }
        Rectangle {
            vertical-stretch: 1;
        if App.page == 0 : Home {}
        if App.page == 1 : Wizard {}
        if App.page == 2 : Backups {}
        if App.page == 3 : Packs {}
        if App.page == 4 : Settings {}
        if App.page == 5 : About {}
        if App.page == 6 : FirstStart {}
        if App.page == 7 : HealthPage {}
        if App.page == 8 : LivePage {}
        if App.page == 9 : ChannelsPage {}
        if App.page == 10 : SearchLogPage { app-busy: App.busy; }
        }
    }

    // the second confirmation of the install without backup
    if App.confirm-open : Rectangle {
        background: Theme.scrim;
        TouchArea {}
        Card {
            width: min(parent.width - 80px, 560px);
            height: cv.preferred-height;
            cv := VerticalLayout {
                padding: Theme.pad * 1.25; spacing: Theme.gap * 1.5;
                Title { text: Tr.t(Tr.lang, "confirm_title"); color: Theme.danger; }
                Label { text: Tr.t(Tr.lang, "confirm_text"); }
                HorizontalLayout {
                    spacing: Theme.gap; alignment: end;
                    Button { text: Tr.t(Tr.lang, "b_cancel"); default-focus: true; clicked => { App.confirm-open = false; } }
                    Button { text: Tr.t(Tr.lang, "b_confirm_none"); kind: "danger"; clicked => { App.confirm-no-backup(); } }
                }
            }
        }
    }
}
