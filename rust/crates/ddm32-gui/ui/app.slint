// SPDX-License-Identifier: GPL-3.0-or-later
// DDM32 Plus: one window. A home screen with one main action, a wizard that asks one thing per screen, and four plain
// pages (backups, data packs, settings, about). Every colour from Theme, every text from Tr (tr / en).
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Tr, Label, Muted, Title, Heading, Button, Card, Notice, Check, Choice, Progress, PageHeader, Modal } from "widgets.slint";
import { MenuBar } from "menubar.slint";
import { Radio, Fact, TableRow, PortRow, ZoneRow, HealthPage, LivePage, ChannelsPage, SearchLogPage, DisclaimerGate } from "radio_pages.slint";
import { App, Packs, VersionRow, BackupRow, VerRow, HelpItem } from "state.slint";
import { Page, ProgramUpdate, VersionsPage, HelpPage, PacksPage, Section } from "pages.slint";
export { Theme, Tr, Radio, Fact, TableRow, PortRow, ZoneRow, Modal, App, Packs, VersionRow, BackupRow, VerRow, HelpItem }



component Home inherits VerticalLayout {
    padding: 0;
    spacing: 0;
    // the header row: the program's name and the owner's mark (in the theme's own variant); the versions are in the
    // facts bar ("Program 3.0.0 · Radio firmware 1.0.1")
    PageHeader {
        heading: "DDM32 Plus";
        subtitle: "by d0ukan · TA2DOU";
        back: false;
        logo: Theme.dark ? @image-url("logo-dark.png") : @image-url("logo-light.png");
    }
    VerticalLayout {
        padding: Theme.pad;
        spacing: Theme.gap;
        vertical-stretch: 1;
        // the cable and the version on offer
        Notice { text: App.radio-text; kind: App.radio-kind; }
        if !Radio.disclaimer-ok : DisclaimerGate {}
        if App.update-text != "" : Muted { text: App.update-text; font-size: Theme.font; }
        // a failed update check: one small line, dismissable
        if App.port-missing != "" : HorizontalLayout {
            spacing: Theme.gap;
            Notice { text: App.port-missing; kind: "warning"; horizontal-stretch: 1; }
            Button { text: Tr.t(Tr.lang, "b_dismiss"); horizontal-stretch: 0; clicked => { App.dismiss-port-missing(); } }
        }
        if App.check-error != "" : HorizontalLayout {
            spacing: Theme.gap;
            Muted { text: App.check-error; vertical-alignment: center; horizontal-stretch: 1; }
            Button { text: Tr.t(Tr.lang, "b_dismiss"); horizontal-stretch: 0; clicked => { App.dismiss-check-error(); } }
        }
        // the main action
        HorizontalLayout {
            padding-top: 6px;
            padding-bottom: 6px;
            alignment: start;
            Button {
                text: Tr.t(Tr.lang, "home_update");
                kind: "primary";
                big: true;
                default-focus: true;
                min-width: 240px;
                clicked => { App.navigate(1); }
            }
        }
        HorizontalLayout {
            spacing: Theme.gap;
            Button { even: true; text: Tr.t(Tr.lang, "home_backups"); clicked => { App.navigate(2); } }
            Button { even: true; text: Tr.t(Tr.lang, "home_packs"); clicked => { App.navigate(3); } }
            Button { even: true; text: Tr.t(Tr.lang, "home_channels"); clicked => { App.navigate(9); } }
            Button { even: true; text: Tr.t(Tr.lang, "home_versions"); clicked => { App.navigate(11); } }
        }
        HorizontalLayout {
            spacing: Theme.gap;
            Button { even: true; text: Tr.t(Tr.lang, "home_health"); clicked => { App.navigate(7); } }
            Button { even: true; text: Tr.t(Tr.lang, "home_live"); clicked => { App.navigate(8); } }
            Button { even: true; text: Tr.t(Tr.lang, "home_slog"); clicked => { App.navigate(10); } }
            Button { even: true; text: Tr.t(Tr.lang, "home_settings"); clicked => { App.navigate(4); } }
        }
        Rectangle { vertical-stretch: 1; }
    }
    // calm facts, in a bar at the bottom: what the radio runs (by the last backup) and where the backups are
    Rectangle {
        background: Theme.surface;
        vertical-stretch: 0;
        min-height: facts.preferred-height;
        Rectangle { y: 0; height: 1px; background: Theme.border; }
        facts := HorizontalLayout {
            padding-left: Theme.pad;
            padding-right: Theme.pad;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: Theme.gap;
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Label { text: App.version-line; font-size: Theme.font-small; }
                Muted { text: App.backups-text + "  " + App.backups-folder; }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                Button { text: Tr.t(Tr.lang, "b_open"); clicked => { App.open-backups-folder(); } }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                Button { text: Tr.t(Tr.lang, "home_about"); clicked => { App.navigate(5); } }
            }
        }
    }
}

// the wizard's steps in one row: done in green, the current one in the accent with a line under it, the rest muted
component StepBar inherits HorizontalLayout {
    spacing: 4px;
    for name[i] in [Tr.t(Tr.lang, "s_version"), Tr.t(Tr.lang, "s_backup"), Tr.t(Tr.lang, "s_check"), Tr.t(Tr.lang, "s_install"), Tr.t(Tr.lang, "s_done")] : Rectangle {
        property <int> n: i == 0 ? 0 : i == 1 ? 1 : i == 2 ? 3 : i == 3 ? 4 : 5;
        property <bool> active: App.step == n || (i == 1 && App.step == 2);
        property <bool> done: App.step > n && !active;
        // five equal parts, whatever the words
        preferred-width: 100px;
        horizontal-stretch: 1;
        min-height: st.preferred-height + 12px;
        st := Text {
            text: (i + 1) + ". " + name;
            color: active ? Theme.accent-text : done ? Theme.success : Theme.text-muted;
            font-size: Theme.font-small;
            font-weight: active ? 600 : 400;
            horizontal-alignment: center;
            wrap: word-wrap;
            width: parent.width - 8px;
        }
        Rectangle {
            y: parent.height - 2px;
            height: 2px;
            background: active ? Theme.primary : done ? Theme.success : Theme.border;
        }
    }
}

component Wizard inherits Page {
    heading: Tr.t(Tr.lang, "home_update");
    gated: true;
    StepBar {}
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: Theme.gap;
            padding-right: 8px;
            alignment: start;
            // 0: which version
            if App.step == 0 : VerticalLayout {
                spacing: Theme.gap;
                alignment: start;
                Heading { text: Tr.t(Tr.lang, "q_version"); font-size: Theme.font-big; }
                for v[i] in App.versions : Choice {
                    title: v.version + "   " + v.label;
                    detail: v.notes;
                    selected: App.selected-version == i;
                    clicked => { App.selected-version = i; }
                }
                if App.versions.length == 0 : Notice { text: Tr.t(Tr.lang, "no_versions"); kind: "warning"; }
            }
            // 1: how to keep the radio safe
            if App.step == 1 : VerticalLayout {
                spacing: Theme.gap;
                alignment: start;
                Heading { text: Tr.t(Tr.lang, "q_backup"); font-size: Theme.font-big; }
                Choice {
                    title: Tr.t(Tr.lang, "c_new"); detail: Tr.t(Tr.lang, "c_new_d");
                    selected: App.backup-choice == 0;
                    clicked => { App.choose-backup(0); }
                }
                Choice {
                    title: Tr.t(Tr.lang, "c_quick");
                    detail: App.quick-available ? Tr.t(Tr.lang, "c_quick_d") + " " + App.quick-backup : Tr.t(Tr.lang, "c_quick_none");
                    enabled: App.quick-available;
                    selected: App.backup-choice == 1;
                    clicked => { App.choose-backup(1); }
                }
                Choice {
                    title: Tr.t(Tr.lang, "c_none"); detail: Tr.t(Tr.lang, "c_none_d");
                    danger: true;
                    selected: App.backup-choice == 2;
                    clicked => { App.choose-backup(2); }
                }
                if App.backup-choice == 2 : VerticalLayout {
                    spacing: Theme.gap;
                    Notice { text: Tr.t(Tr.lang, "none_warning"); kind: "danger"; }
                    Check { text: Tr.t(Tr.lang, "none_understood"); checked <=> App.understood; }
                }
                // over DDM32 Plus the map pack goes first (H.3): 1.0.x ignores it, a failed install leaves a working radio
                if App.map-first : VerticalLayout {
                if App.map-available : Section {
                    title: Tr.t(Tr.lang, "map_title");
                    text: Tr.t(Tr.lang, App.map-first && App.step == 1 ? "map_first_text" : "map_after_text");
                    HorizontalLayout {
                        alignment: start;
                        Button {
                            text: Tr.t(Tr.lang, "map_write"); kind: App.map-done ? "secondary" : "primary";
                            enabled: !App.busy && App.radio-access && !Radio.slog-running && !Radio.live-running && Radio.disclaimer-ok;
                            clicked => { App.map-write(); }
                        }
                    }
                    if App.map-text != "" : Notice { text: App.map-text; kind: App.map-kind; }
                }
                }
            }
            // 2: the backup (a radio step: one button, the radio switched off and on)
            if App.step == 2 : VerticalLayout {
                spacing: Theme.gap;
                alignment: start;
                if Radio.access && Radio.port-line != "" : Muted { text: Radio.port-line; }
                Notice { text: App.power-prompt; kind: "warning"; big: true; }
                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: Tr.t(Tr.lang, "b_start_backup"); kind: "primary"; big: true;
                        enabled: !App.busy && !App.step-done && App.radio-access && !Radio.slog-running && Radio.disclaimer-ok;
                        clicked => { App.start-backup(); }
                    }
                }
            }
            // 3: the check, in plain words; the numbers under Details
            if App.step == 3 : VerticalLayout {
                spacing: Theme.gap;
                alignment: start;
                Label { text: App.summary; }
            }
            // 4: the install (a radio step)
            if App.step == 4 : VerticalLayout {
                spacing: Theme.gap;
                alignment: start;
                if Radio.access && Radio.port-line != "" : Muted { text: Radio.port-line; }
                Notice { text: App.power-prompt; kind: "warning"; big: true; }
                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: Tr.t(Tr.lang, "b_start_install"); kind: App.backup-choice == 2 ? "danger" : "primary"; big: true;
                        enabled: !App.busy && !App.step-done && App.radio-access && !Radio.slog-running && Radio.disclaimer-ok;
                        clicked => { App.start-install(); }
                    }
                }
            }
            // 5: done
            if App.step == 5 : VerticalLayout {
                spacing: Theme.gap;
                alignment: start;
                Notice { text: Tr.t(Tr.lang, "done_text"); kind: "success"; big: true; }
                // from the factory firmware the pack follows the firmware (H.3); over DDM32 Plus a pack not yet written
                if !App.map-first || !App.map-done : VerticalLayout {
                if App.map-available : Section {
                    title: Tr.t(Tr.lang, "map_title");
                    text: Tr.t(Tr.lang, App.map-first && App.step == 1 ? "map_first_text" : "map_after_text");
                    HorizontalLayout {
                        alignment: start;
                        Button {
                            text: Tr.t(Tr.lang, "map_write"); kind: App.map-done ? "secondary" : "primary";
                            enabled: !App.busy && App.radio-access && !Radio.slog-running && !Radio.live-running && Radio.disclaimer-ok;
                            clicked => { App.map-write(); }
                        }
                    }
                    if App.map-text != "" : Notice { text: App.map-text; kind: App.map-kind; }
                }
                }
            }
            if App.busy || App.progress > 0 : VerticalLayout {
                spacing: 6px;
                Progress { value: App.progress; }
                Muted { text: App.progress-text; }
                if App.progress-info != "" : Muted { text: App.progress-info; font-size: Theme.font-small; }
            }
            if App.message != "" : Notice { text: App.message; kind: App.message-kind; }
            if !App.radio-access && (App.step == 2 || App.step == 4) : Notice { text: Tr.t(Tr.lang, "no_radio_access"); kind: "warning"; }
            if App.details != "" : VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: (App.show-details ? "− " : "+ ") + Tr.t(Tr.lang, "details");
                        clicked => { App.show-details = !App.show-details; }
                    }
                }
                if App.show-details : Card {
                    min-height: dt.preferred-height + 24px;
                    dt := Text {
                        x: 12px; width: parent.width - 24px;
                        text: App.details; color: Theme.text-muted; font-size: Theme.font-small; font-family: "Consolas";
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
    HorizontalLayout {
        spacing: Theme.gap;
        alignment: end;
        vertical-stretch: 0;
        if App.step > 0 && App.step < 5 : Button {
            text: Tr.t(Tr.lang, "b_back"); enabled: !App.busy;
            clicked => { App.wizard-back(); }
        }
        if App.step < 5 : Button {
            text: Tr.t(Tr.lang, "b_next"); kind: "primary"; default-focus: true;
            enabled: !App.busy && Radio.disclaimer-ok && (App.step == 0 ? App.versions.length > 0
                : App.step == 1 ? (App.backup-choice != 2 || App.understood)
                : App.step-done);
            clicked => { App.wizard-next(); }
        }
        if App.step == 5 : Button { text: Tr.t(Tr.lang, "b_finish"); kind: "primary"; default-focus: true; clicked => { App.navigate(0); } }
    }
}

component Backups inherits Page {
    heading: Tr.t(Tr.lang, "home_backups");
    gated: true;
    // scrolls as a whole when the window is small (150 % / 200 %); the backups list is one part of it
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: Theme.gap;
            padding-right: 8px;
            alignment: start;
            Muted { text: Tr.t(Tr.lang, "res_text"); font-size: Theme.font; }
            Muted { text: Tr.t(Tr.lang, "backups_where") + " " + App.backups-folder; }
            if Radio.access && Radio.port-line != "" : Muted { text: Radio.port-line; }
            // the C# RestorePage shortcuts: the backup before the last install, the stock firmware backup, any folder
            HorizontalLayout {
                spacing: Theme.gap;
                VerticalLayout {
                    spacing: 4px;
                    horizontal-stretch: 1;
                    Button { text: Tr.t(Tr.lang, "res_previous"); enabled: !App.busy; clicked => { App.res-previous(); } }
                    Muted { text: Tr.t(Tr.lang, "res_previous_tip"); }
                }
                VerticalLayout {
                    spacing: 4px;
                    horizontal-stretch: 1;
                    Button { text: Tr.t(Tr.lang, "res_stock"); enabled: !App.busy; clicked => { App.res-stock(); } }
                    Muted { text: Tr.t(Tr.lang, "res_stock_tip"); }
                }
            }
            HorizontalLayout {
                alignment: start;
                Button { text: Tr.t(Tr.lang, "res_other"); enabled: !App.busy; clicked => { App.res-other(); } }
            }
            Muted { text: Tr.t(Tr.lang, "res_list"); }
            for b[i] in App.backups : Choice {
                title: b.name; detail: b.detail;
                selected: App.selected-backup == i;
                enabled: !App.busy;
                clicked => { App.selected-backup = i; App.restore-plan(); }
            }
            if App.backups.length == 0 : Notice { text: Tr.t(Tr.lang, "backups_none"); }
        }
    }
    if App.res-status != "" : Label { text: App.res-status; vertical-stretch: 0; }
    if App.message != "" : Notice { text: App.message; kind: App.message-kind; }
    if App.busy || App.progress > 0 : VerticalLayout {
        spacing: 6px;
        vertical-stretch: 0;
        Progress { value: App.progress; }
        if App.progress-text != "" : Muted { text: App.progress-text; }
        if App.progress-info != "" : Muted { text: App.progress-info; font-size: Theme.font-small; }
    }
    HorizontalLayout {
        spacing: Theme.gap;
        alignment: end;
        vertical-stretch: 0;
        Button { text: Tr.t(Tr.lang, "b_open_folder"); clicked => { App.open-backups-folder(); } }
        Button {
            text: Tr.t(Tr.lang, "b_restore"); kind: "primary";
            enabled: App.restore-ready && !App.busy && App.radio-access && !Radio.slog-running && Radio.disclaimer-ok;
            clicked => { App.restore(); }
        }
    }
}

component Settings inherits Page {
    heading: Tr.t(Tr.lang, "home_settings");
    // scrolls when the window is small (150 % / 200 % scaling on a small screen)
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: Theme.gap;
            padding-right: 8px;
            alignment: start;
            Heading { text: Tr.t(Tr.lang, "set_lang"); }
            HorizontalLayout {
                spacing: Theme.gap;
                Choice { title: "Türkçe"; detail: ""; selected: Tr.lang == "tr"; clicked => { App.set-lang("tr"); } }
                Choice { title: "English"; detail: ""; selected: Tr.lang == "en"; clicked => { App.set-lang("en"); } }
            }
            Heading { text: Tr.t(Tr.lang, "set_theme"); }
            HorizontalLayout {
                spacing: Theme.gap;
                Choice { title: Tr.t(Tr.lang, "theme_light"); detail: ""; selected: !Theme.dark; clicked => { App.set-theme(false); } }
                Choice { title: Tr.t(Tr.lang, "theme_dark"); detail: ""; selected: Theme.dark; clicked => { App.set-theme(true); } }
            }
            Heading { text: Tr.t(Tr.lang, "set_channel"); }
            HorizontalLayout {
                spacing: Theme.gap;
                Choice { title: Tr.t(Tr.lang, "ch_latest"); detail: Tr.t(Tr.lang, "ch_latest_d"); selected: App.channel == 0; clicked => { App.set-channel(0); } }
                Choice { title: Tr.t(Tr.lang, "ch_beta"); detail: Tr.t(Tr.lang, "ch_beta_d"); selected: App.channel == 1; clicked => { App.set-channel(1); } }
                Choice { title: Tr.t(Tr.lang, "ch_test"); detail: Tr.t(Tr.lang, "ch_test_d"); selected: App.channel == 2; danger: true; clicked => { App.set-channel(2); } }
            }
            Check {
                text: Tr.t(Tr.lang, "set_auto");
                checked <=> App.auto-check;
                toggled => { App.set-auto-check(App.auto-check); }
            }
            ProgramUpdate {}
        }
    }
}

component About inherits Page {
    heading: Tr.t(Tr.lang, "home_about");
    // scrolls when the window is small (150 % / 200 % scaling on a small screen)
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: Theme.gap;
            padding-right: 8px;
            alignment: start;
            Card {
                min-height: av.preferred-height;
                av := VerticalLayout {
                    padding: Theme.pad; spacing: 8px;
                    Heading { text: "DDM32 Plus"; font-size: Theme.font-big; }
                    Label { text: Tr.t(Tr.lang, "about_text"); }
                    Label { text: Tr.t(Tr.lang, "ab_program") + " " + App.version; }
                    Label { text: Tr.t(Tr.lang, "ab_firmware") + " " + App.installed-firmware; }
                    Muted { text: Tr.t(Tr.lang, "ver_source"); }
                    Muted { text: Tr.t(Tr.lang, "about_data") + " " + App.data-folder; }
                    Muted { text: Tr.t(Tr.lang, "about_key") + " " + App.key-id; }
                    Muted { text: "d0ukan · TA2DOU — github.com/d0ukan/DDM32-Plus"; }
                    Muted { text: Tr.t(Tr.lang, "about_licence"); }
                    Muted { text: "Made with Slint (slint.dev)"; }
                }
            }
            ProgramUpdate {}
        }
    }
}

// the first start: the language, before anything else
component FirstStart inherits VerticalLayout {
    padding: Theme.pad * 2;
    spacing: Theme.gap * 1.5;
    alignment: center;
    Title { text: "DDM32 Plus"; horizontal-alignment: center; }
    Label { text: "Dil seçin / Choose a language"; horizontal-alignment: center; }
    HorizontalLayout {
        spacing: Theme.gap;
        alignment: center;
        Button { text: "Türkçe"; kind: "primary"; big: true; default-focus: true; min-width: 160px; clicked => { App.set-lang("tr"); App.navigate(0); } }
        Button { text: "English"; kind: "primary"; big: true; min-width: 160px; clicked => { App.set-lang("en"); App.navigate(0); } }
    }
}

// a Yes / No question over the window: No has the focus (Enter = No), Yes is the page's step
component YesNo inherits Rectangle {
    in property <string> title;
    in property <string> text;
    in property <string> yes;
    in property <bool> danger: true;
    callback yes-clicked();
    callback no-clicked();
    background: Theme.scrim;
    TouchArea {}
    Card {
        width: min(parent.width - 48px, 600px);
        height: min(yv.preferred-height, parent.height - 32px);
        ScrollView {
            width: parent.width;
            height: parent.height;
            yv := VerticalLayout {
                padding: Theme.pad * 1.25; spacing: Theme.gap * 1.5;
                Title { text: root.title; }
                Label { text: root.text; vertical-alignment: top; }
                HorizontalLayout {
                    spacing: Theme.gap; alignment: end;
                    Button { text: Tr.t(Tr.lang, "b_no"); in-dialog: true; default-focus: true; clicked => { root.no-clicked(); } }
                    Button { text: root.yes; kind: root.danger ? "danger" : "primary"; in-dialog: true; clicked => { root.yes-clicked(); } }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: App.title-text;
    // the title bar and taskbar icon (the program's logo, as the setup's shortcuts)
    icon: @image-url("../../../packaging/art/ddm32plus.png");
    preferred-width: 900px;
    preferred-height: 720px;
    min-width: 640px;
    min-height: 560px;
    background: Theme.window;
    default-font-size: Theme.font;
    // a dialog is open: the controls under it take no keyboard focus and no click (widgets.slint Modal)
    property <bool> modal: App.prompt-open || Radio.picker-open || App.confirm-open || App.disc-open || App.test-confirm-open || App.force-close-open
        || App.res-confirm-open || Packs.download-confirm-open || Packs.write-confirm-open || Radio.zone-picker-open || App.map-ask-open;
    changed modal => { Modal.open = self.modal; }

    VerticalLayout {
        padding: 0;
        spacing: 0;
        if App.page != 6 : MenuBar {
            radio-locked: App.menu-radio-locked || App.confirm-open || App.disc-open || App.test-confirm-open
                || App.res-confirm-open || Packs.download-confirm-open || Packs.write-confirm-open || App.map-ask-open;
            developer: App.developer;
            lang: Tr.lang;
            cable-text: Radio.access ? Radio.port-head : "";
            cable-locked: App.port-locked;
            action(a) => { App.menu-action(a); }
            cable-clicked => { Radio.picker-open = true; Radio.port-rescan(); }
        }
        Rectangle {
            vertical-stretch: 1;
        if App.page == 0 : Home {}
        if App.page == 1 : Wizard {}
        if App.page == 2 : Backups {}
        if App.page == 3 : PacksPage {}
        if App.page == 4 : Settings {}
        if App.page == 5 : About {}
        if App.page == 6 : FirstStart {}
        if App.page == 7 : HealthPage {}
        if App.page == 8 : LivePage {}
        if App.page == 9 : ChannelsPage {}
        if App.page == 10 : SearchLogPage { app-busy: App.busy; }
        if App.page == 11 : VersionsPage {}
        if App.page == 12 : HelpPage {}
        }
    }

    // the one update question after the start-up check (never while a radio job holds the port; lib.rs consider_prompt).
    // A firmware update only opens the wizard: every radio step still starts from the user's own click.
    if App.prompt-open : Rectangle {
        background: Theme.scrim;
        TouchArea {}
        Card {
            width: min(parent.width - 48px, 600px);
            height: min(pv.preferred-height, parent.height - 32px);
            pv := VerticalLayout {
                padding: Theme.pad * 1.25; spacing: Theme.gap;
                Title { text: Tr.t(Tr.lang, "prompt_title"); }
                if App.prompt-program != "" : VerticalLayout {
                    spacing: 6px;
                    Heading { text: App.prompt-program; }
                    Muted { text: App.prompt-program-detail; }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Theme.gap;
                        Button { text: Tr.t(Tr.lang, "b_update_now"); kind: "primary"; in-dialog: true; clicked => { App.prompt-update-program(); } }
                        Button { text: Tr.t(Tr.lang, "b_skip_version"); in-dialog: true; clicked => { App.prompt-skip-program(); } }
                    }
                }
                if App.prompt-firmware != "" : VerticalLayout {
                    spacing: 6px;
                    Heading { text: App.prompt-firmware; }
                    Muted { text: App.prompt-firmware-detail; }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Theme.gap;
                        Button { text: Tr.t(Tr.lang, "b_update_now"); kind: "primary"; in-dialog: true; clicked => { App.prompt-update-firmware(); } }
                        Button { text: Tr.t(Tr.lang, "b_skip_version"); in-dialog: true; clicked => { App.prompt-skip-firmware(); } }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.gap; alignment: end;
                    Button { text: Tr.t(Tr.lang, "b_later"); in-dialog: true; default-focus: true; clicked => { App.prompt-later(); } }
                }
            }
        }
    }

    // the cable picker: Auto (CH340), each CH340 cable, and under Advanced every other port the OS lists
    if Radio.picker-open : Rectangle {
        background: Theme.scrim;
        TouchArea {}
        Card {
            width: min(parent.width - 48px, 600px);
            height: min(kv.preferred-height, parent.height - 32px);
            kv := VerticalLayout {
                padding: Theme.pad * 1.25; spacing: Theme.gap;
                Title { text: Tr.t(Tr.lang, "port_title"); }
                Muted { text: Tr.t(Tr.lang, "port_intro"); }
                ScrollView {
                    vertical-stretch: 1;
                    min-height: min(pl.preferred-height, 120px);
                    preferred-height: pl.preferred-height;
                    pl := VerticalLayout {
                        spacing: 8px;
                        padding-right: 8px;
                        alignment: start;
                        Choice {
                            title: Tr.t(Tr.lang, "port_auto"); detail: Radio.port-auto-detail;
                            in-dialog: true;
                            selected: Radio.port-auto;
                            clicked => { Radio.port-choose(""); }
                        }
                        for p in Radio.port-cables : Choice {
                            title: p.name; detail: p.detail;
                            in-dialog: true;
                            selected: !Radio.port-auto && Radio.port-selected == p.name;
                            clicked => { Radio.port-choose(p.name); }
                        }
                        HorizontalLayout {
                            alignment: start;
                            Button {
                                text: (Radio.picker-advanced ? "− " : "+ ") + Tr.t(Tr.lang, "port_advanced");
                                in-dialog: true;
                                clicked => { Radio.picker-advanced = !Radio.picker-advanced; }
                            }
                        }
                        if Radio.picker-advanced : Notice { text: Tr.t(Tr.lang, "port_advanced_warn"); kind: "warning"; }
                        if Radio.picker-advanced : VerticalLayout {
                            spacing: 8px;
                            for p in Radio.port-others : Choice {
                                title: p.name; detail: p.detail;
                                in-dialog: true;
                                selected: !Radio.port-auto && Radio.port-selected == p.name;
                                clicked => { Radio.port-choose(p.name); }
                            }
                            if Radio.port-others.length == 0 : Muted { text: Tr.t(Tr.lang, "port_none_other"); }
                        }
                    }
                }
                if Radio.port-note != "" : Notice { text: Radio.port-note; kind: "warning"; }
                HorizontalLayout {
                    spacing: Theme.gap; alignment: end;
                    Button { text: Tr.t(Tr.lang, "b_rescan"); in-dialog: true; clicked => { Radio.port-rescan(); } }
                    Button { text: Tr.t(Tr.lang, "b_close"); kind: "primary"; in-dialog: true; default-focus: true; clicked => { Radio.picker-open = false; } }
                }
            }
        }
    }

    // "Close anyway?": only reachable while no radio write runs (lib.rs close_requested); No has the focus
    if App.force-close-open : Rectangle {
        background: Theme.scrim;
        TouchArea {}
        Card {
            width: min(parent.width - 48px, 560px);
            height: min(fv.preferred-height, parent.height - 32px);
            fv := VerticalLayout {
                padding: Theme.pad * 1.25; spacing: Theme.gap * 1.5;
                Title { text: Tr.t(Tr.lang, "close_anyway_title"); }
                Label { text: Tr.t(Tr.lang, "close_anyway_text"); }
                HorizontalLayout {
                    spacing: Theme.gap; alignment: end;
                    Button { text: Tr.t(Tr.lang, "b_no"); in-dialog: true; default-focus: true; clicked => { App.force-close-open = false; } }
                    Button { text: Tr.t(Tr.lang, "close_anyway_yes"); kind: "danger"; in-dialog: true; clicked => { App.force-close-yes(); } }
                }
            }
        }
    }

    // a test / alpha version was chosen: Yes / No before anything is downloaded, No has the focus (Enter = No)
    if App.test-confirm-open : Rectangle {
        background: Theme.scrim;
        TouchArea {}
        Card {
            width: min(parent.width - 48px, 560px);
            height: min(tv.preferred-height, parent.height - 32px);
            tv := VerticalLayout {
                padding: Theme.pad * 1.25; spacing: Theme.gap * 1.5;
                Title { text: Tr.t(Tr.lang, "ver_test_title"); }
                Label { text: App.test-confirm-text; }
                HorizontalLayout {
                    spacing: Theme.gap; alignment: end;
                    Button { text: Tr.t(Tr.lang, "b_no"); in-dialog: true; default-focus: true; clicked => { App.test-confirm-open = false; } }
                    Button { text: Tr.t(Tr.lang, "ver_test_yes"); kind: "danger"; in-dialog: true; clicked => { App.test-confirm-yes(); } }
                }
            }
        }
    }

    // a Yes / No question of a page (No has the focus): restore, download user.csv, write a data pack
    if App.res-confirm-open : YesNo {
        title: Tr.t(Tr.lang, "res_confirm_title");
        text: App.res-confirm-text;
        yes: Tr.t(Tr.lang, "res_confirm_yes");
        no-clicked => { App.res-confirm-open = false; }
        yes-clicked => { App.res-confirm-yes(); }
    }
    if Packs.download-confirm-open : YesNo {
        title: Tr.t(Tr.lang, "pack_download");
        text: Packs.download-confirm-text;
        yes: Tr.t(Tr.lang, "pack_download_yes");
        danger: false;
        no-clicked => { Packs.download-confirm-open = false; }
        yes-clicked => { Packs.download-yes(); }
    }
    if Packs.write-confirm-open : YesNo {
        title: Tr.t(Tr.lang, "pack_confirm_title");
        text: Packs.write-confirm-text;
        yes: Tr.t(Tr.lang, "pack_confirm_yes");
        no-clicked => { Packs.write-confirm-open = false; }
        yes-clicked => { Packs.write-yes(); }
    }

    // the map pack step found a pack the user built: never replaced without a choice (E.3 S-B); no choice writes nothing
    if App.map-ask-open : Rectangle {
        background: Theme.scrim;
        TouchArea {}
        Card {
            width: min(parent.width - 48px, 600px);
            height: min(mv.preferred-height, parent.height - 32px);
            mv := VerticalLayout {
                padding: Theme.pad * 1.25; spacing: Theme.gap * 1.5;
                Title { text: Tr.t(Tr.lang, "map_ask_title"); }
                Label { text: App.map-ask-text; }
                if App.map-ask-rebuild : Button { text: Tr.t(Tr.lang, "map_ask_rebuild"); kind: "primary"; in-dialog: true; clicked => { App.map-choose("rebuild"); } }
                if App.map-ask-keep : Button { text: Tr.t(Tr.lang, "map_ask_keep"); in-dialog: true; clicked => { App.map-choose("keep"); } }
                Muted { text: Tr.t(Tr.lang, "map_ask_release_warning"); }
                Button { text: Tr.t(Tr.lang, "map_ask_release"); kind: "danger"; in-dialog: true; clicked => { App.map-choose("release"); } }
                HorizontalLayout {
                    spacing: Theme.gap; alignment: end;
                    Button { text: Tr.t(Tr.lang, "map_ask_none"); in-dialog: true; default-focus: true; clicked => { App.map-ask-open = false; } }
                }
            }
        }
    }

    // my channels: the zone or mode filter (all, or one zone's channels / one mode)
    if Radio.zone-picker-open : Rectangle {
        background: Theme.scrim;
        TouchArea {}
        Card {
            width: min(parent.width - 48px, 600px);
            height: min(zv.preferred-height, parent.height - 32px);
            zv := VerticalLayout {
                padding: Theme.pad * 1.25; spacing: Theme.gap;
                Title { text: Radio.pick-title; }
                Muted { text: Tr.t(Tr.lang, "ch_zone_intro"); }
                ScrollView {
                    vertical-stretch: 1;
                    min-height: min(zl.preferred-height, 120px);
                    preferred-height: zl.preferred-height;
                    zl := VerticalLayout {
                        spacing: 8px;
                        padding-right: 8px;
                        alignment: start;
                        for z in Radio.pick-rows : Choice {
                            title: z.name; detail: "";
                            in-dialog: true;
                            selected: Radio.pick-selected == z.key;
                            clicked => { Radio.pick(z.key); }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.gap; alignment: end;
                    Button { text: Tr.t(Tr.lang, "b_close"); kind: "primary"; in-dialog: true; default-focus: true; clicked => { Radio.zone-picker-open = false; } }
                }
            }
        }
    }

    // the disclaimer: at the first start (after the language), whenever its text changed, and from Help. While it is
    // not accepted every radio step is off (lib.rs radio_allowed).
    if App.disc-open : Rectangle {
        background: Theme.scrim;
        TouchArea {}
        Card {
            width: min(parent.width - 32px, 720px);
            height: parent.height - 32px;
            VerticalLayout {
                padding: Theme.pad * 1.25; spacing: Theme.gap;
                HorizontalLayout {
                    spacing: Theme.gap;
                    Title { text: App.disc-title; vertical-alignment: center; horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: start;
                        horizontal-stretch: 0;
                        Button { text: App.disc-lang == "en" ? "Türkçe" : "English"; in-dialog: true; clicked => { App.disc-toggle-lang(); } }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.window;
                    ScrollView {
                        width: parent.width;
                        height: parent.height;
                        dv := VerticalLayout {
                            padding: Theme.pad; spacing: 8px;
                            alignment: start;
                            Label { text: App.disc-intro; vertical-alignment: top; }
                            for p in App.disc-points : HorizontalLayout {
                                spacing: 8px;
                                padding-left: 12px;
                                Text { text: "•"; color: Theme.text; font-size: Theme.font; horizontal-stretch: 0; vertical-alignment: top; }
                                Label { text: p; vertical-alignment: top; horizontal-stretch: 1; }
                            }
                            Label { text: App.disc-outro; vertical-alignment: top; font-weight: App.disc-outro-bold ? 600 : 400; }
                        }
                    }
                }
                if !App.disc-readonly : Check { text: Tr.t(Tr.lang, "disc_check"); in-dialog: true; checked <=> App.disc-checked; }
                if App.disc-readonly : Notice { text: Tr.t(Tr.lang, "disc_accepted"); kind: "success"; }
                HorizontalLayout {
                    spacing: Theme.gap; alignment: end;
                    if !App.disc-readonly : Button { text: Tr.t(Tr.lang, "disc_reject"); in-dialog: true; clicked => { App.disc-reject(); } }
                    if !App.disc-readonly : Button {
                        text: Tr.t(Tr.lang, "disc_accept"); kind: "primary"; in-dialog: true;
                        enabled: App.disc-checked;
                        clicked => { App.disc-accept(); }
                    }
                    if App.disc-readonly : Button { text: Tr.t(Tr.lang, "b_close"); kind: "primary"; in-dialog: true; default-focus: true; clicked => { App.disc-open = false; } }
                }
            }
        }
    }

    // the second confirmation of the install without backup
    if App.confirm-open : Rectangle {
        background: Theme.scrim;
        TouchArea {}
        Card {
            width: min(parent.width - 80px, 560px);
            height: cv.preferred-height;
            cv := VerticalLayout {
                padding: Theme.pad * 1.25; spacing: Theme.gap * 1.5;
                Title { text: Tr.t(Tr.lang, "confirm_title"); color: Theme.danger; }
                Label { text: Tr.t(Tr.lang, "confirm_text"); }
                HorizontalLayout {
                    spacing: Theme.gap; alignment: end;
                    Button { text: Tr.t(Tr.lang, "b_cancel"); in-dialog: true; default-focus: true; clicked => { App.confirm-open = false; } }
                    Button { text: Tr.t(Tr.lang, "b_confirm_none"); kind: "danger"; in-dialog: true; clicked => { App.confirm-no-backup(); } }
                }
            }
        }
    }
}
