// The few widgets the program is made of, all coloured by Theme only. Plain desktop controls: small corners, normal
// heights, a 2 px focus ring; colour only for the accent (main action, selection) and for states.
import { Theme } from "theme.slint";

export global Tr {
    in-out property <string> lang: "tr";
    // T.t(lang, key): the text in the chosen language (the Rust table); `lang` makes bindings follow a change
    pure callback t(string, string) -> string;
}

// A dialog is open (lib.rs / app.slint keep it in step): the controls under its shade take no keyboard focus and no
// click, and read as disabled to a screen reader; only the dialog's own controls (`in-dialog`) stay live.
export global Modal {
    in-out property <bool> open: false;
}

export component Label inherits Text {
    color: Theme.text;
    font-size: Theme.font;
    wrap: word-wrap;
    vertical-alignment: center;
}

export component Muted inherits Text {
    color: Theme.text-muted;
    font-size: Theme.font-small;
    wrap: word-wrap;
}

export component Title inherits Text {
    color: Theme.text;
    font-size: Theme.font-title;
    font-weight: 600;
    wrap: word-wrap;
}

// A section's name above its controls
export component Heading inherits Text {
    color: Theme.text;
    font-size: Theme.font;
    font-weight: 600;
    wrap: word-wrap;
}

// kind: "primary" (the one obvious next step), "secondary", "danger"
export component Button {
    in property <string> text;
    in property <string> kind: "secondary";
    in property <bool> enabled: true;
    // a little taller for a page's main action; same font
    in property <bool> big: false;
    // in a row of equal buttons (Home's tools): every one the same width, whatever its label
    in property <bool> even: false;
    // takes the keyboard focus when the page opens, so Enter runs it
    in property <bool> default-focus: false;
    // a control of the open dialog (stays live while Modal.open)
    in property <bool> in-dialog: false;
    property <bool> live: root.enabled && (root.in-dialog || !Modal.open);
    callback clicked;
    init => { if root.default-focus && root.live { fs.focus(); } }
    // grows with a label that wraps (large scaling, narrow window), so no line is ever cut
    min-height: max(root.big ? 40px : Theme.control-height, lbl.preferred-height + 10px);
    max-height: max(root.big ? 40px : Theme.control-height, lbl.preferred-height + 10px);
    preferred-width: root.even ? 100px : max(96px, lbl.preferred-width + 32px);
    vertical-stretch: 0;
    min-width: 88px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.live;
    accessible-action-default => { if root.live { root.clicked(); } }

    fs := FocusScope {
        enabled: root.live;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") && root.live { root.clicked(); return accept; }
            reject
        }
    }
    bg := Rectangle {
        border-radius: Theme.radius;
        background: !root.enabled ? Theme.disabled
            : root.kind == "primary" ? (ta.has-hover ? Theme.primary-hover : Theme.primary)
            : root.kind == "danger" ? Theme.danger
            : (ta.has-hover ? Theme.button-hover : Theme.button);
        border-width: fs.has-focus ? 2px : (root.kind == "secondary" || !root.enabled ? 1px : 0px);
        border-color: fs.has-focus ? Theme.focus : Theme.border;
        lbl := Text {
            text: root.text;
            color: !root.enabled ? Theme.disabled-text
                : root.kind == "primary" ? Theme.primary-text
                : root.kind == "danger" ? Theme.window
                : Theme.button-text;
            font-size: Theme.font;
            font-weight: root.kind == "secondary" ? 400 : 600;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
            x: 12px;
            width: parent.width - 24px;
        }
    }
    ta := TouchArea {
        enabled: root.live;
        mouse-cursor: root.live ? pointer : default;
        clicked => { fs.focus(); root.clicked(); }
    }
}

export component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
}

// The header row of every page: the way back home (when there is one) and the page's name, on a bar across the
// window with a line under it.
export component PageHeader inherits Rectangle {
    in property <string> heading;
    in property <bool> back: true;
    in property <bool> back-enabled: true;
    in property <string> back-text;
    // the owner's mark before the name (Home)
    in property <image> logo;
    // a small line under the name (Home: the author's mark)
    in property <string> subtitle;
    callback back-clicked;
    background: Theme.surface;
    min-height: hl.preferred-height;
    vertical-stretch: 0;
    hl := HorizontalLayout {
        padding-left: Theme.pad;
        padding-right: Theme.pad;
        padding-top: 8px;
        padding-bottom: 9px;
        spacing: Theme.gap * 1.5;
        if root.back : Button {
            text: "← " + root.back-text;
            enabled: root.back-enabled;
            horizontal-stretch: 0;
            clicked => { root.back-clicked(); }
        }
        if root.logo.width > 0 : Image {
            source: root.logo;
            width: 34px;
            height: 34px;
            image-fit: contain;
            accessible-role: image;
            accessible-label: "DDM32+";
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 0px;
            Title { text: root.heading; vertical-alignment: center; }
            if root.subtitle != "" : Muted { text: root.subtitle; font-size: Theme.font-small; overflow: elide; }
        }
        @children
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
}

// A notice: kind "info", "warning", "danger", "success". A plain box with a bar on the left in the state's colour.
export component Notice inherits Rectangle {
    in property <string> text;
    in property <string> kind: "info";
    // a step the user must follow now (the power prompts, the result): its text in bold
    in property <bool> big: false;
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    min-height: t.preferred-height + 20px;
    preferred-height: self.min-height;
    vertical-stretch: 0;
    Rectangle {
        x: 0; y: 0; width: 4px; height: parent.height;
        border-top-left-radius: Theme.radius;
        border-bottom-left-radius: Theme.radius;
        background: kind == "danger" ? Theme.danger : kind == "warning" ? Theme.warning
            : kind == "success" ? Theme.success : Theme.border;
    }
    t := Text {
        x: 16px;
        width: parent.width - 28px;
        text: root.text;
        wrap: word-wrap;
        vertical-alignment: center;
        font-size: Theme.font;
        font-weight: root.big ? 600 : 400;
        color: Theme.text;
    }
}

export component Check {
    in property <string> text;
    in-out property <bool> checked;
    in property <bool> in-dialog: false;
    property <bool> live: root.in-dialog || !Modal.open;
    callback toggled;
    min-height: max(Theme.control-height, ct.preferred-height + 8px);
    accessible-role: checkbox;
    accessible-checked: root.checked;
    accessible-label: root.text;
    accessible-enabled: root.live;
    fs := FocusScope {
        enabled: root.live;
        key-pressed(event) => {
            if event.text == " " { root.checked = !root.checked; root.toggled(); return accept; }
            reject
        }
    }
    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: 18px; height: 18px; y: (parent.height - 18px) / 2;
            border-radius: Theme.radius;
            border-width: fs.has-focus ? 2px : 1px;
            border-color: fs.has-focus ? Theme.focus : root.checked ? Theme.primary : Theme.border;
            background: root.checked ? Theme.primary : Theme.surface;
            // the tick, drawn (no font glyph needed)
            if root.checked : Path {
                width: 12px; height: 12px;
                viewbox-width: 12; viewbox-height: 12;
                commands: "M 1.5 6.5 L 4.5 9.5 L 10.5 2.5";
                stroke: Theme.primary-text;
                stroke-width: 2px;
                fill: transparent;
            }
        }
        ct := Text { text: root.text; color: Theme.text; font-size: Theme.font; wrap: word-wrap; vertical-alignment: center; }
    }
    TouchArea { enabled: root.live; clicked => { fs.focus(); root.checked = !root.checked; root.toggled(); } }
}

// One choice of a list: a row with a round mark, a title and a line under it
export component Choice {
    in property <string> title;
    in property <string> detail;
    in property <bool> selected;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <bool> in-dialog: false;
    property <bool> live: root.enabled && (root.in-dialog || !Modal.open);
    callback clicked;
    min-height: max(Theme.control-height + 4px, cl.preferred-height);
    vertical-stretch: 0;
    accessible-role: button;
    accessible-label: root.title;
    accessible-enabled: root.live;
    fs := FocusScope {
        enabled: root.live;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") && root.live { root.clicked(); return accept; }
            reject
        }
    }
    Rectangle {
        background: !root.enabled ? Theme.disabled : Theme.surface;
        border-radius: Theme.radius;
        border-width: fs.has-focus || root.selected ? 2px : 1px;
        border-color: fs.has-focus ? Theme.focus : root.selected ? (root.danger ? Theme.danger : Theme.primary) : Theme.border;
        cl := HorizontalLayout {
            padding-left: 12px; padding-right: 12px; padding-top: 8px; padding-bottom: 8px;
            spacing: 10px;
            // the round mark: a ring, filled in the middle when chosen
            VerticalLayout {
                alignment: start;
                padding-top: 2px;
                Rectangle {
                    width: 16px; height: 16px; border-radius: 8px;
                    border-width: 1px;
                    border-color: root.selected ? (root.danger ? Theme.danger : Theme.primary) : Theme.text-muted;
                    background: Theme.surface;
                    if root.selected : Rectangle {
                        width: 8px; height: 8px; border-radius: 4px;
                        background: root.danger ? Theme.danger : Theme.primary;
                    }
                }
            }
            VerticalLayout {
                spacing: 2px;
                alignment: center;
                Text {
                    text: root.title;
                    color: !root.enabled ? Theme.disabled-text : root.danger ? Theme.danger : Theme.text;
                    font-size: Theme.font; font-weight: 600; wrap: word-wrap;
                }
                if root.detail != "" : Text { text: root.detail; color: !root.enabled ? Theme.disabled-text : Theme.text-muted; font-size: Theme.font-small; wrap: word-wrap; }
            }
        }
    }
    TouchArea { enabled: root.live; clicked => { fs.focus(); root.clicked(); } }
}

// A one-line text field with its name above it (the name is also the screen reader's label)
export component Field inherits VerticalLayout {
    in property <string> label;
    in-out property <string> text;
    in property <bool> enabled: true;
    callback edited(string);
    spacing: 4px;
    vertical-stretch: 0;
    Text { text: root.label; color: Theme.text-muted; font-size: Theme.font-small; wrap: word-wrap; }
    Rectangle {
        min-height: Theme.control-height;
        border-radius: Theme.radius;
        background: root.enabled ? Theme.surface : Theme.disabled;
        border-width: fi.has-focus ? 2px : 1px;
        border-color: fi.has-focus ? Theme.focus : Theme.border;
        fi := TextInput {
            x: 10px;
            width: parent.width - 20px;
            text <=> root.text;
            enabled: root.enabled && !Modal.open;
            color: root.enabled ? Theme.text : Theme.disabled-text;
            font-size: Theme.font;
            vertical-alignment: center;
            single-line: true;
            selection-background-color: Theme.primary;
            selection-foreground-color: Theme.primary-text;
            accessible-role: text-input;
            accessible-label: root.label;
            edited => { root.edited(self.text); }
        }
    }
}

export component Progress inherits Rectangle {
    in property <float> value; // 0..1
    height: 8px;
    accessible-role: progress-indicator;
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    accessible-value: round(clamp(root.value, 0, 1) * 100);
    vertical-stretch: 0;
    border-radius: 2px;
    background: Theme.surface-alt;
    border-width: 1px;
    border-color: Theme.border;
    Rectangle {
        x: 0; y: 0; height: parent.height; border-radius: 2px;
        width: parent.width * clamp(root.value, 0, 1);
        background: Theme.primary;
    }
}
