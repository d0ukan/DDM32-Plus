// The read-only radio pages: health, live view, my channels, the search log. Every colour from Theme, every text from Tr.
import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Tr, Label, Muted, Title, Heading, Button, Card, Notice, Choice, Check, Progress, PageHeader, Modal } from "widgets.slint";

export struct Fact { label: string, value: string }
export struct TableRow { cells: [string] }
export struct PortRow { name: string, detail: string }
// one entry of the channels page's filter picker: its key ("zone:5", "mode:DMR", "zone:-1" = all) and its name
export struct ZoneRow { key: string, name: string }

export global Radio {
    // health
    in property <string> health-verdict: "grey";   // grey, green, amber, red
    in property <string> health-text;
    in property <[Fact]> health-facts;
    in property <[Fact]> health-tasks;
    in property <string> health-raw;
    // live
    in property <bool> live-running;
    in property <float> live-signal;               // 0..1
    in property <string> live-smeter;
    in property <string> live-dbm;
    in property <[Fact]> live-facts;
    in property <string> live-raw;
    in-out property <int> live-interval: 2;
    // search log
    in property <bool> slog-running;
    in property <string> slog-status;
    in property <string> slog-searches;
    in property <[TableRow]> slog-rows;
    in-out property <bool> slog-confirm;
    // channels
    in property <string> channels-source;
    in property <[string]> table-columns;
    in property <[TableRow]> table-rows;
    in property <[float]> table-widths;
    in property <string> table-count;
    in-out property <int> table: 0;                // 0 channels, 1 zones, 2 contacts, 3 lists
    in-out property <string> search;
    // the channels' filters (zone, mode), all columns, the sort (column, ascending), another backup (channels.rs)
    in property <string> channels-radio;
    in property <string> zone-text;
    in property <string> mode-text;
    in-out property <bool> all-columns;
    in property <int> sort-column: -1;
    in property <bool> sort-ascending: true;
    // the table's width in px when it is wider than the window (all columns: it scrolls sideways); 0 = fit
    in property <float> table-min-width: 0;
    in property <bool> table-loaded;
    // the filter picker (zone or mode): its title, its entries, the chosen key
    in-out property <bool> zone-picker-open;
    in property <string> pick-title;
    in property <[ZoneRow]> pick-rows;
    in property <string> pick-selected;
    callback pick(string);
    callback open-zone-picker();
    callback open-mode-picker();
    callback toggle-columns(bool);
    callback sort(int);
    callback zone-activate(int);
    callback open-backup();
    // health: the cable check (the device list; no port opened), the read every 30 s, the last read's time
    in property <string> cable-text;
    in property <string> cable-kind: "info";
    in-out property <bool> health-auto;
    in property <string> health-when;
    callback check-cable();
    callback health-auto-changed(bool);
    // shared
    in property <string> message;
    in property <string> message-kind: "info";
    in property <bool> busy;
    in-out property <bool> show-raw;
    // the cable picker (lib.rs scan_ports / show_ports): the header's text, the port a radio page uses, the lists.
    // Ports come only from the OS's list; none is opened to choose.
    // a serial port is compiled in (the `radio` feature): without it the cable control and port lines are hidden
    in property <bool> access: true;
    in property <string> port-head;
    in property <string> port-line;
    in property <string> port-note;
    in property <bool> port-auto: true;
    in property <string> port-selected;
    in property <string> port-auto-detail;
    in property <[PortRow]> port-cables;
    in property <[PortRow]> port-others;
    in-out property <bool> picker-open;
    in-out property <bool> picker-advanced;
    // the disclaimer was accepted (lib.rs radio_allowed): every radio step stays off until it is
    in property <bool> disclaimer-ok;
    callback open-disclaimer();

    callback read-health();
    callback live-start();
    callback live-stop();
    callback slog-start();
    callback slog-stop();
    callback slog-folder();
    callback slog-clear();
    callback choose-table(int);
    callback search-changed(string);
    callback export-csv();
    callback navigate-home();
    // "" = Auto (CH340)
    callback port-choose(string);
    callback port-rescan();
}

// the disclaimer was not accepted: said on every page with a radio step, with the way to read and accept it
export component DisclaimerGate inherits VerticalLayout {
    spacing: 8px;
    vertical-stretch: 0;
    Notice { text: Tr.t(Tr.lang, "disc_not_accepted"); kind: "warning"; }
    HorizontalLayout {
        alignment: start;
        Button { text: Tr.t(Tr.lang, "disc_read_button"); kind: "primary"; clicked => { Radio.open-disclaimer(); } }
    }
}

// a radio page: the header row across the window (home stays closed while the live reader runs), then the content
component Screen inherits VerticalLayout {
    in property <string> heading;
    // the port this page's radio step uses (my channels reads a backup only)
    in property <bool> show-port: true;
    padding: 0;
    spacing: 0;
    PageHeader {
        heading: root.heading;
        back-text: Tr.t(Tr.lang, "back_home");
        back-enabled: !Radio.busy && !Radio.live-running && !Radio.slog-running;
        back-clicked => { Radio.navigate-home(); }
    }
    VerticalLayout {
        padding: Theme.pad;
        spacing: Theme.gap;
        vertical-stretch: 1;
        if root.show-port && Radio.access && Radio.port-line != "" : Muted { text: Radio.port-line; }
        if root.show-port && !Radio.disclaimer-ok : DisclaimerGate {}
        @children
    }
}

component FactList inherits VerticalLayout {
    in property <[Fact]> facts;
    spacing: 4px;
    for f in root.facts : HorizontalLayout {
        spacing: Theme.gap;
        Text { text: f.label; color: Theme.text-muted; font-size: Theme.font-small; width: 240px; wrap: word-wrap; }
        Text { text: f.value; color: Theme.text; font-size: Theme.font; wrap: word-wrap; horizontal-stretch: 1; }
    }
}

component Raw inherits VerticalLayout {
    in property <string> text;
    spacing: 6px;
    if root.text != "" : HorizontalLayout {
        alignment: start;
        Button {
            text: (Radio.show-raw ? "− " : "+ ") + Tr.t(Tr.lang, "details");
            clicked => { Radio.show-raw = !Radio.show-raw; }
        }
    }
    if Radio.show-raw && root.text != "" : Card {
        min-height: rt.preferred-height + 24px;
        rt := Text {
            x: 12px;
            width: parent.width - 24px;
            text: root.text;
            color: Theme.text-muted;
            font-size: Theme.font-small;
            font-family: "Consolas";
            wrap: word-wrap;
        }
    }
}

export component HealthPage inherits Screen {
    heading: Tr.t(Tr.lang, "home_health");
    Muted { text: Tr.t(Tr.lang, "health_intro"); }
    // the cable (the C# HealthPage card): the computer's device list, read without opening a port
    HorizontalLayout {
        spacing: Theme.gap;
        if Radio.cable-text != "" : Notice { text: Radio.cable-text; kind: Radio.cable-kind; horizontal-stretch: 1; }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Button { text: Tr.t(Tr.lang, "health_cable_check"); clicked => { Radio.check-cable(); } }
        }
    }
    HorizontalLayout {
        spacing: Theme.gap;
        alignment: start;
        Button {
            text: Tr.t(Tr.lang, "b_read_health");
            kind: "primary";
            big: true;
            default-focus: true;
            horizontal-stretch: 0;
            // the search log holds the port while it runs (radio_pages.rs slog_holds_port)
            enabled: !Radio.busy && !Radio.slog-running && Radio.disclaimer-ok;
            clicked => { Radio.read-health(); }
        }
        VerticalLayout {
            alignment: center;
            Check {
                text: Tr.t(Tr.lang, "health_auto");
                checked <=> Radio.health-auto;
                toggled => { Radio.health-auto-changed(Radio.health-auto); }
            }
        }
    }
    if Radio.health-when != "" : Muted { text: Radio.health-when; }
    if Radio.health-verdict != "grey" : Notice {
        text: Radio.health-text;
        big: true;
        kind: Radio.health-verdict == "green" ? "success" : Radio.health-verdict == "amber" ? "warning" : "danger";
    }
    if Radio.message != "" : Notice { text: Radio.message; kind: Radio.message-kind; }
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: start;
            spacing: Theme.gap;
            padding-right: 8px;
            FactList { facts: Radio.health-facts; }
            if Radio.health-tasks.length > 0 : Heading { text: Tr.t(Tr.lang, "health_tasks"); }
            FactList { facts: Radio.health-tasks; }
            Raw { text: Radio.health-raw; }
        }
    }
}

export component LivePage inherits Screen {
    heading: Tr.t(Tr.lang, "home_live");
    Muted { text: Tr.t(Tr.lang, "live_intro"); }
    HorizontalLayout {
        spacing: Theme.gap;
        alignment: start;
        Button {
            text: Radio.live-running ? Tr.t(Tr.lang, "b_live_stop") : Tr.t(Tr.lang, "b_live_start");
            kind: Radio.live-running ? "secondary" : "primary";
            big: true;
            horizontal-stretch: 0;
            enabled: !Radio.busy && (Radio.live-running || (!Radio.slog-running && Radio.disclaimer-ok));
            clicked => {
                if Radio.live-running {
                    Radio.live-stop();
                } else {
                    Radio.live-start();
                }
            }
        }
        for s in [1, 2, 5] : Choice {
            title: s + " " + Tr.t(Tr.lang, "live_seconds");
            detail: "";
            selected: Radio.live-interval == s;
            enabled: !Radio.live-running;
            horizontal-stretch: 0;
            min-width: 96px;
            clicked => { Radio.live-interval = s; }
        }
    }
    Card {
        vertical-stretch: 0;
        min-height: sv.preferred-height;
        sv := VerticalLayout {
            padding: Theme.pad;
            spacing: 8px;
            HorizontalLayout {
                spacing: Theme.gap;
                Text {
                    text: Radio.live-smeter == "" ? "—" : Radio.live-smeter;
                    color: Theme.text;
                    font-size: 28px;
                    font-weight: 700;
                    width: 150px;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    Progress { value: Radio.live-signal; }
                    Muted { text: Radio.live-dbm; }
                }
            }
        }
    }
    if Radio.message != "" : Notice { text: Radio.message; kind: Radio.message-kind; }
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: start;
            spacing: Theme.gap;
            padding-right: 8px;
            FactList { facts: Radio.live-facts; }
            Raw { text: Radio.live-raw; }
        }
    }
}

export component ChannelsPage inherits Screen {
    heading: Tr.t(Tr.lang, "home_channels");
    show-port: false;
    Notice { text: Tr.t(Tr.lang, "ch_warn"); kind: "warning"; }
    if Radio.channels-source != "" : Muted { text: Radio.channels-source; }
    if Radio.channels-radio != "" : Muted { text: Radio.channels-radio; }
    HorizontalLayout {
        spacing: 8px;
        for name[i] in [Tr.t(Tr.lang, "t_channels"), Tr.t(Tr.lang, "t_zones"), Tr.t(Tr.lang, "t_contacts"), Tr.t(Tr.lang, "t_lists")] : Choice {
            title: name;
            detail: "";
            selected: Radio.table == i;
            clicked => { Radio.choose-table(i); }
        }
    }
    HorizontalLayout {
        spacing: Theme.gap;
        Rectangle {
            min-height: Theme.control-height;
            border-radius: Theme.radius;
            background: Theme.surface;
            border-width: si.has-focus ? 2px : 1px;
            border-color: si.has-focus ? Theme.focus : Theme.border;
            si := TextInput {
                x: 12px;
                width: parent.width - 24px;
                text <=> Radio.search;
                enabled: !Modal.open;
                color: Theme.text;
                font-size: Theme.font;
                vertical-alignment: center;
                single-line: true;
                selection-background-color: Theme.primary;
                selection-foreground-color: Theme.primary-text;
                accessible-role: text-input;
                accessible-label: Tr.t(Tr.lang, "search");
                edited => { Radio.search-changed(self.text); }
            }
            if Radio.search == "" : Text {
                x: 12px;
                text: Tr.t(Tr.lang, "search");
                color: Theme.text-muted;
                font-size: Theme.font;
                vertical-alignment: center;
            }
        }
        Muted { text: Radio.table-count; vertical-alignment: center; horizontal-stretch: 0; font-size: Theme.font-small; }
        Button {
            text: Tr.t(Tr.lang, "b_csv");
            horizontal-stretch: 0;
            enabled: Radio.table-rows.length > 0;
            clicked => { Radio.export-csv(); }
        }
        Button { text: Tr.t(Tr.lang, "ch_open"); horizontal-stretch: 0; clicked => { Radio.open-backup(); } }
    }
    // the channels' own filters (the C# zone and mode boxes) and all columns
    if Radio.table == 0 && Radio.table-loaded : HorizontalLayout {
        spacing: Theme.gap;
        alignment: start;
        Button { text: Radio.zone-text; clicked => { Radio.open-zone-picker(); } }
        Button { text: Radio.mode-text; clicked => { Radio.open-mode-picker(); } }
        VerticalLayout {
            alignment: center;
            Check {
                text: Tr.t(Tr.lang, "ch_all_columns");
                checked <=> Radio.all-columns;
                toggled => { Radio.toggle-columns(Radio.all-columns); }
            }
        }
    }
    if Radio.message != "" : Notice { text: Radio.message; kind: Radio.message-kind; }
    tc := Card {
        vertical-stretch: 1;
        // the table's width: the card's, or (all columns) wider, then it scrolls sideways; the rows scroll inside
        property <length> table-w: max(self.width - 2px, Radio.table-min-width * 1px);
        property <length> cols-w: self.table-w - 16px - 16px - 8px * max(0, Radio.table-columns.length - 1) - 14px;
        hs := ScrollView {
            width: parent.width;
            height: parent.height;
            viewport-width: tc.table-w;
            viewport-height: self.visible-height;
            VerticalLayout {
                width: tc.table-w;
                height: hs.visible-height;
                padding: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    padding-left: 8px;
                    padding-right: 8px;
                    height: 32px;
                    // a column's title sorts by it (again: the other way round); numbers as numbers
                    for c[i] in Radio.table-columns : Rectangle {
                        width: tc.cols-w * Radio.table-widths[i];
                        accessible-role: button;
                        accessible-label: Tr.t(Tr.lang, "ch_sort") + " (" + c + ")";
                        accessible-action-default => { Radio.sort(i); }
                        Text {
                            width: parent.width;
                            text: c + (Radio.sort-column == i ? (Radio.sort-ascending ? " ↑" : " ↓") : "");
                            color: Theme.text-muted;
                            font-size: Theme.font-small;
                            font-weight: 700;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        TouchArea { enabled: !Modal.open; mouse-cursor: pointer; clicked => { Radio.sort(i); } }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                if Radio.table-rows.length == 0 : Notice { text: Tr.t(Tr.lang, "channels_none"); }
                ListView {
                    vertical-stretch: 1;
                    for r[ri] in Radio.table-rows : Rectangle {
                        height: max(30px, rl.preferred-height + 10px);
                        background: Math.mod(ri, 2) == 0 ? Theme.surface : Theme.surface-alt;
                        rl := HorizontalLayout {
                            spacing: 8px;
                            padding-left: 8px;
                            padding-right: 8px;
                            for c[i] in r.cells : Text {
                                text: c;
                                color: Theme.text;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                                vertical-alignment: center;
                                width: tc.cols-w * Radio.table-widths[i];
                            }
                        }
                        // a zone's row: a double click shows its channels (the C# zone double-click)
                        if Radio.table == 1 : TouchArea {
                            enabled: !Modal.open;
                            double-clicked => { Radio.zone-activate(ri); }
                        }
                    }
                }
            }
        }
    }
}

export component SearchLogPage inherits Screen {
    // App.busy (a backup, install, restore or pack write holds the port), passed in by app.slint
    in property <bool> app-busy;
    // the search log: the radio's P25 / DMR search finds read every second (radio_pages.rs slog_*), newest first
    property <[float]> widths: [0.13, 0.13, 0.06, 0.1, 0.12, 0.1, 0.1, 0.18, 0.08];
    property <length> cols-w: self.width - 2 * Theme.pad - 16px - 16px - 8px * 8 - 14px;
    heading: Tr.t(Tr.lang, "home_slog");
    Muted { text: Tr.t(Tr.lang, "slog_intro"); }
    HorizontalLayout {
        spacing: Theme.gap;
        Button {
            text: Radio.slog-running ? Tr.t(Tr.lang, "b_live_stop") : Tr.t(Tr.lang, "b_slog_start");
            kind: Radio.slog-running ? "secondary" : "primary";
            big: true;
            enabled: Radio.slog-running || (!Radio.busy && !Radio.live-running && !root.app-busy && Radio.disclaimer-ok);
            horizontal-stretch: 0;
            clicked => {
                if Radio.slog-running {
                    Radio.slog-stop();
                } else {
                    Radio.slog-start();
                }
            }
        }
        Button { text: Tr.t(Tr.lang, "b_slog_folder"); horizontal-stretch: 0; clicked => { Radio.slog-folder(); } }
        if !Radio.slog-confirm : Button {
            text: Tr.t(Tr.lang, "b_slog_clear");
            horizontal-stretch: 0;
            enabled: Radio.slog-rows.length > 0;
            clicked => { Radio.slog-confirm = true; }
        }
        // "Kayıtları temizle" asks once: the table and today's CSV file go
        if Radio.slog-confirm : Button {
            text: Tr.t(Tr.lang, "b_slog_clear_yes");
            kind: "danger";
            horizontal-stretch: 0;
            clicked => { Radio.slog-clear(); }
        }
        if Radio.slog-confirm : Button {
            text: Tr.t(Tr.lang, "b_cancel_short");
            horizontal-stretch: 0;
            clicked => { Radio.slog-confirm = false; }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    Muted { text: Radio.slog-status; }
    if Radio.slog-searches != "" : Muted { text: Radio.slog-searches; }
    if Radio.message != "" : Notice { text: Radio.message; kind: Radio.message-kind; }
    Card {
        vertical-stretch: 1;
        VerticalLayout {
            padding: 8px;
            HorizontalLayout {
                spacing: 8px;
                padding-left: 8px;
                padding-right: 8px;
                height: 32px;
                for c[i] in [Tr.t(Tr.lang, "slog_first"), Tr.t(Tr.lang, "slog_time"), Tr.t(Tr.lang, "slog_mode"), "MHz", "NAC / CC", Tr.t(Tr.lang, "slog_slot"),
                        Tr.t(Tr.lang, "slog_group"), Tr.t(Tr.lang, "slog_source"), Tr.t(Tr.lang, "slog_calls")] : Text {
                    text: c;
                    color: Theme.text-muted;
                    font-size: Theme.font-small;
                    font-weight: 700;
                    vertical-alignment: center;
                    width: root.cols-w * root.widths[i];
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            if Radio.slog-rows.length == 0 : Notice { text: Tr.t(Tr.lang, "slog_none"); }
            ListView {
                vertical-stretch: 1;
                for r[ri] in Radio.slog-rows : Rectangle {
                    height: 28px;
                    background: Math.mod(ri, 2) == 0 ? Theme.surface : Theme.surface-alt;
                    HorizontalLayout {
                        spacing: 8px;
                        padding-left: 8px;
                        padding-right: 8px;
                        for c[i] in r.cells : Text {
                            text: c;
                            color: Theme.text;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                            overflow: elide;
                            width: root.cols-w * root.widths[i];
                        }
                    }
                }
            }
        }
    }
}
